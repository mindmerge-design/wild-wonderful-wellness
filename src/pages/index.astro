---
// Packages
import { SEO } from 'astro-seo'
import {
ArrowRight,
Award,
Calendar,
Camera,
Compass,
Map as MapIcon,
MapPin,
Mountain,
Sun,
TreePine
} from 'lucide-astro'

// Components
import Badge from '@/components/elements/content/Badge.astro'
import Card from '@/components/elements/content/Card.astro'
import PortableText from '@/components/elements/content/PortableText.astro'
import Container from '@/components/layout/Container.astro'
import Section from '@/components/layout/Section.astro'
import ParkMap from '@/components/ParkMap.tsx'
import { Button } from '@/components/starwind/button'
import Layout from '@/layouts/Layout.astro'

// Sanity
import { loadQuery } from '@/sanity/lib/load-query'
import { featuredParksQuery, featuredPartnersQuery, homeQuery } from '@/sanity/lib/queries'
import { urlForImage } from '@/sanity/lib/urlForImage'
import type { Home } from '@/sanity/schemaTypes/home'
import type { ParkTrail } from '@/sanity/schemaTypes/parkTrail'
import type { Partner } from '@/sanity/schemaTypes/partner'

// Load home page data
const { data: home } = await loadQuery<Home>({ query: homeQuery })

// Load featured parks from Sanity
const { data: featuredParks } = await loadQuery<ParkTrail[]>({ query: featuredParksQuery })
const parks = featuredParks || []

// Load featured partners from Sanity
const { data: featuredPartners } = await loadQuery<Partner[]>({ query: featuredPartnersQuery })
const partners = featuredPartners || []

const siteName = 'Wild & Wonderful Wellness'
const pageTitle = 'Wellness Passport'
const pageDescription =
	"Explore Monongalia County's parks, trails, and wellness activities. Collect stamps, earn rewards, and build healthier habits — one adventure at a time."

const howItWorks = [
	{
		step: 1,
		title: 'Pick Up Your Passport',
		description:
			'Free at the Monongalia County Health Department or any participating partner location.',
		icon: 'stamp'
	},
	{
		step: 2,
		title: 'Collect Stamps',
		description:
			'Visit parks, trails, and partner sites to stamp your book. Each location has a mounted lockbox with a custom self-inking stamp inside.',
		icon: 'compass'
	},
	{
		step: 3,
		title: 'Earn Prizes',
		description:
			'Turn in your completed passport at MCHD to redeem rewards. The more stamps you collect, the bigger the prizes!',
		icon: 'gift'
	}
]

const mapboxToken = import.meta.env.PUBLIC_MAPBOX_TOKEN || ''

const upcomingEvents = [
	{
		title: 'Spring Kickoff Hike',
		date: 'March 22, 2026',
		location: 'Coopers Rock State Forest',
		description: 'Guided 3-mile hike to celebrate the start of the spring passport season. All skill levels welcome.'
	},
	{
		title: 'Yoga in the Park',
		date: 'April 5, 2026',
		location: 'Dorsey Knob Park',
		description: 'Sunrise yoga session led by certified instructors. Bring a mat and earn a wellness stamp.'
	},
	{
		title: 'Community Health Fair',
		date: 'April 19, 2026',
		location: 'Mountaineer Mall',
		description: 'Free health screenings, nutrition workshops, and passport stamp stations. Pick up your passport here!'
	},
	{
		title: 'Trail Run 5K',
		date: 'May 10, 2026',
		location: 'Rail Trail, Morgantown',
		description: 'Timed 5K along the scenic rail trail. Finishers earn two passport stamps and a commemorative bib.'
	}
]
---

<Layout>
	<SEO
		title={`${pageTitle} | ${siteName}`}
		description={pageDescription}
		openGraph={{
			basic: {
				title: `${pageTitle} | ${siteName}`,
				type: 'website',
				image: ''
			}
		}}
		slot="head"
	/>

	<!-- ============================================ -->
	<!-- 1. HERO                                      -->
	<!-- ============================================ -->
	<div class="relative min-h-[75vh] overflow-hidden bg-primary">
		

		<!-- Gradient overlays -->
		<div class="absolute inset-0 bg-linear-to-b from-black/40 via-black/10 to-black/60"></div>

		<!-- Floating trail markers decoration -->
		<div class="absolute top-16 right-[8%] animate-pulse-soft opacity-40" aria-hidden="true">
			<MapPin class="text-white! size-12" />
		</div>
		<div class="absolute bottom-32 left-[12%] animate-pulse-soft opacity-35" style="animation-delay: 0.5s" aria-hidden="true">
			<TreePine class="text-white! size-10" />
		</div>
		<div class="absolute top-1/3 left-[6%] animate-pulse-soft opacity-30" style="animation-delay: 1s" aria-hidden="true">
			<Compass class="text-white! size-14" />
		</div>
		<div class="absolute bottom-1/4 right-[15%] animate-pulse-soft opacity-25" style="animation-delay: 1.5s" aria-hidden="true">
			<Mountain class="text-white! size-11" />
		</div>
		<div class="absolute top-1/4 right-[20%] animate-pulse-soft opacity-20" style="animation-delay: 0.8s" aria-hidden="true">
			<Sun class="text-white! size-9" />
		</div>

		<Container class="relative z-10 flex min-h-[75vh] flex-col justify-center py-20">
			<div class="grid items-center gap-6 lg:grid-cols-6 ">
				<!-- Left: Text Content -->
				<div class="col-span-4" style="animation: fade-in-up 0.8s ease-out both;">
					<div class="mb-6 inline-flex items-center gap-2 rounded-full border border-white/30 bg-white/10 px-5 py-2.5 text-sm font-medium text-white!/95 backdrop-blur-md shadow-lg">
						
						<span class="text-white!">Monongalia County Health Department</span>
					</div>

					<h1 class="mb-0 text-5xl font-extrabold leading-[1.05] tracking-tight text-white! md:text-6xl lg:text-7xl">
						Wild and Wonderful
						<span class="block text-orange-500">Wellness Passport</span>
					</h1>

					<p class="mt-6 text-2xl font-semibold tracking-wide text-white/90!">
						Explore. Move. Earn Rewards.
					</p>

					<div class="mt-10 flex flex-wrap gap-4">
						<Button href="#introduction" variant="outline" size="lg" class="no-underline bg-white">
							Learn More
							<ArrowRight class="size-5" />
						</Button>
					</div>
				</div>

				<!-- Right: Hero Image from Sanity -->
				{home?.hero?.heroImage && (
					<div class="lg:col-span-2 lg:flex lg:justify-center col-span-6" style="animation: fade-in-left 0.8s ease-out 0.3s both;">
						<div class="relative aspect-square w-full rounded-xl shadow-2xl overflow-hidden">
							<!-- Decorative glow -->
							<div class="absolute -inset-4 bg-accent/20 rounded-full blur-3xl"></div>
							<!-- Hero Image -->
							<img
								src={urlForImage(home.hero.heroImage).width(600).height(800).url()}
								alt={home.hero.heroImage.alt || 'Wellness Passport'}
								width={400}
								height={533}
								class="absolute inset-0 w-full h-full object-cover my-0!"
							/>
						</div>
					</div>
				)}
			</div>
		</Container>

		<!-- Organic nature divider - rolling hills silhouette -->
		<div class="absolute -bottom-1 left-0 right-0">
			<svg viewBox="0 0 1440 200" class="w-full text-background" preserveAspectRatio="none">
				<path fill="currentColor" d="M0,160 Q180,100 360,140 T720,120 T1080,140 T1440,100 L1440,200 L0,200Z"/>
				<path fill="currentColor" opacity="0.6" d="M0,180 Q240,120 480,160 T960,140 T1440,160 L1440,200 L0,200Z"/>
				<path fill="currentColor" opacity="0.3" d="M0,190 Q360,150 720,170 T1440,150 L1440,200 L0,200Z"/>
			</svg>
		</div>
	</div>

	<main id="main-content">
		<!-- ============================================ -->
		<!-- 2. INTRODUCTION                              -->
		<!-- ============================================ -->
		<Section id="introduction" class="relative overflow-hidden">
			<!-- Decorative topo pattern -->
			<div class="absolute inset-0 text-primary/5 pointer-events-none">
				<svg class="h-full w-full" xmlns="http://www.w3.org/2000/svg">
					<defs>
						<pattern id="topo-intro" x="0" y="0" width="300" height="300" patternUnits="userSpaceOnUse">
							<path d="M 0 150 Q 75 120 150 150 T 300 150" fill="none" stroke="currentColor" stroke-width="1" opacity="0.3"/>
							<path d="M 0 200 Q 100 170 200 200 T 300 200" fill="none" stroke="currentColor" stroke-width="0.8" opacity="0.2"/>
							<circle cx="250" cy="80" r="40" fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.15"/>
						</pattern>
					</defs>
					<rect width="100%" height="100%" fill="url(#topo-intro)"/>
				</svg>
			</div>

			<Container class="relative z-10">
				<div class="grid items-center gap-12 md:grid-cols-3">
					<div class="prose md:col-span-2">
						<PortableText portableText={home?.content} />
					</div>
					<div class="flex justify-center">
						<div class="relative w-full max-w-xs overflow-hidden rounded-2xl bg-gradient-to-br from-info to-info/80 p-6 text-center shadow-2xl">
							<!-- Quarter pie visualization -->
							<div class="mb-5 flex justify-center">
								<div class="relative size-28">
									<!-- Full circle background -->
									<div class="absolute inset-0 rounded-full bg-white/20"></div>
									<!-- 25% slice (1 in 4) - using warning yellow -->
									<div
										class="absolute inset-0 rounded-full"
										style="background: conic-gradient(#f1ce53 0deg 90deg, transparent 90deg 360deg);"
									>
									</div>
									<!-- Inner circle -->
									<div class="absolute inset-3 flex items-center justify-center rounded-full bg-white/95">
										<span class="text-info font-black text-4xl">25%</span>
									</div>
								</div>
							</div>

							<!-- Stat text -->
							<div class="mb-3 flex items-center justify-center gap-3">
								<span class="text-warning font-black text-5xl drop-shadow-sm">1</span>
								<span class="text-white/70 text-2xl">/</span>
								<span class="text-white! font-black text-5xl">4</span>
							</div>

							<p class="text-white! text-xs font-bold uppercase tracking-widest">
								Mon County Residents
							
								are physically inactive
							outside of work</p>

							<!-- Decorative elements -->
							<div class="absolute -right-6 -top-6 size-24 rounded-full bg-warning/30 blur-xl" aria-hidden="true"></div>
							<div class="absolute -bottom-8 -left-8 size-32 rounded-full bg-white/10 blur-xl" aria-hidden="true"></div>
						</div>
					</div>
				</div>
			</Container>
		</Section>

		<!-- ============================================ -->
		<!-- 3. HOW IT WORKS                              -->
		<!-- ============================================ -->
		<Section id="how-it-works" class="bg-muted relative overflow-hidden">
			<!-- Decorative topo pattern -->
			<div class="absolute inset-0 text-success/3 pointer-events-none">
				<svg class="h-full w-full" xmlns="http://www.w3.org/2000/svg">
					<defs>
						<pattern id="topo-how" x="0" y="0" width="250" height="250" patternUnits="userSpaceOnUse">
							<path d="M 0 125 Q 62.5 100 125 125 T 250 125" fill="none" stroke="currentColor" stroke-width="0.8" opacity="0.2"/>
							<path d="M 0 62.5 Q 125 25 250 62.5" fill="none" stroke="currentColor" stroke-width="0.6" opacity="0.15"/>
							<circle cx="200" cy="200" r="30" fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.1"/>
						</pattern>
					</defs>
					<rect width="100%" height="100%" fill="url(#topo-how)"/>
				</svg>
			</div>

			<Container class="relative z-10">
				<div class="mx-auto mb-16 max-w-2xl text-center">
					<Badge variant="primary" class="mb-4">Get Started</Badge>
					<h2 class="text-3xl font-extrabold uppercase md:text-4xl">How It Works</h2>
				</div>

				<!-- Three-step cards -->
				<div class="grid gap-8 md:grid-cols-3">
					{(home?.howItWorks || []).map((step, i) => (
						<div class="relative" style={`animation: fade-in-up 0.6s ease-out ${0.15 * i}s both;`}>
							<Card class="bg-background border border-border text-center transition-all duration-300 hover:shadow-xl hover:-translate-y-1">
								<div class="mb-4 flex justify-center">
									{step.hasIcon && step?.icon && (
										<div class="rounded-full bg-primary/10 p-3 " set:html={step.icon} />
									)}
								</div>
								<h3 class="mb-3 text-xl font-bold">{step.title}</h3>
								<div class="text-muted-foreground text-base leading-relaxed">
									<PortableText portableText={step.description} />
								</div>
							</Card>
						</div>
					))}
				</div>

				<!-- Prizes teaser -->
				<div class="mt-9 relative overflow-hidden rounded-2xl border border-border bg-background p-8 text-center shadow-lg">
					<div class="absolute inset-0 bg-linear-to-br from-warning/5 to-success/5 pointer-events-none"></div>
					<div class="absolute -right-10 -top-10 size-40 bg-warning/10 rounded-full blur-3xl pointer-events-none"></div>
					<div class="absolute -left-10 -bottom-10 size-40 bg-success/10 rounded-full blur-3xl pointer-events-none"></div>
					<div class="relative z-10">
						<div class="mx-auto mb-4 flex size-14 items-center justify-center rounded-full bg-warning/10">
							<Award class="text-warning size-7" />
						</div>
						<div class="text-xl font-semibold text-foreground">
							<PortableText portableText={home?.pricesContent} />
						</div>
					</div>
				</div>

				<!-- Passport booklet placeholder -->
				<div class="mt-12 flex justify-center">
					<div class="w-full max-w-md overflow-hidden rounded-xl border-2 border-dashed border-border bg-background shadow-lg">
						<div class="bg-muted flex aspect-[3/2] items-center justify-center relative overflow-hidden">
							<!-- Decorative background -->
							<div class="absolute inset-0 opacity-20">
								<svg class="h-full w-full" xmlns="http://www.w3.org/2000/svg">
									<defs>
										<pattern id="passport-pattern" x="0" y="0" width="40" height="40" patternUnits="userSpaceOnUse">
											<circle cx="20" cy="20" r="2" fill="currentColor"/>
										</pattern>
									</defs>
									<rect width="100%" height="100%" fill="url(#passport-pattern)"/>
								</svg>
							</div>
							<div class="relative z-10 text-center">
								<div class="mx-auto mb-3 flex size-16 items-center justify-center rounded-full bg-background shadow-md">
									<Camera class="text-muted-foreground size-8" />
								</div>
								<p class="text-muted-foreground font-medium">Passport booklet photo</p>
							</div>
						</div>
						<div class="p-5 text-center bg-background">
							<p class="text-lg font-bold">Your Wellness Passport</p>
							<p class="text-muted-foreground mt-2 text-sm">Pick one up for free at MCHD or any partner location</p>
						</div>
					</div>
				</div>
			</Container>
		</Section>

		<!-- ============================================ -->
		<!-- 4. PARKS & TRAILS                            -->
		<!-- ============================================ -->
		<Section id="parks-trails" class="relative overflow-hidden  py-16">
			<!-- Decorative topo pattern -->
			<div class="absolute inset-0 text-success/4 pointer-events-none">
				<svg class="h-full w-full" xmlns="http://www.w3.org/2000/svg">
					<defs>
						<pattern id="topo-parks" x="0" y="0" width="200" height="200" patternUnits="userSpaceOnUse">
							<path d="M 0 100 Q 50 80 100 100 T 200 100" fill="none" stroke="currentColor" stroke-width="0.8" opacity="0.2"/>
							<path d="M 0 50 Q 100 20 200 50" fill="none" stroke="currentColor" stroke-width="0.6" opacity="0.15"/>
							<path d="M 0 150 Q 100 180 200 150" fill="none" stroke="currentColor" stroke-width="0.6" opacity="0.15"/>
							<circle cx="150" cy="100" r="35" fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.1"/>
						</pattern>
					</defs>
					<rect width="100%" height="100%" fill="url(#topo-parks)"/>
				</svg>
			</div>

			<Container class="relative z-10">
				<div class="mx-auto mb-8 max-w-3xl text-center">
					<Badge variant="success" class="mb-4">Explore</Badge>
					<h2 class="text-3xl font-extrabold uppercase md:text-4xl">Parks & Trails</h2>
				</div>
				<div class="mx-auto mb-12 max-w-3xl">
					<p class="text-muted-foreground text-center text-lg leading-relaxed">
						There are over 30 parks and trails in Monongalia County waiting for you to explore. In each participating location, you will find a mounted lockbox with a custom self-inking stamp inside, which you can use to track your progress and earn credit in your passport.
					</p>
				</div>

				<!-- Full-width Interactive Map -->
				<div class="h-[540px] w-full">
					{mapboxToken ? (
						parks.length > 0 ? (
							<ParkMap parks={parks} mapboxToken={mapboxToken} client:only="react" />
						) : (
							<div class="relative overflow-hidden h-full rounded-2xl">
								<div class="absolute inset-0 bg-success/5"></div>
								<div class="absolute inset-0 flex items-center justify-center">
									<div class="text-center">
										<div class="mx-auto mb-2 flex size-16 items-center justify-center rounded-full bg-background shadow-lg">
											<MapIcon class="text-success size-8" />
										</div>
										<p class="text-sm font-medium text-muted-foreground">No parks to display</p>
										<p class="text-xs text-muted-foreground/70 mt-1">Add parks with coordinates in Sanity</p>
									</div>
								</div>
							</div>
						)
					) : (
						<div class="relative overflow-hidden h-full rounded-2xl">
							<div class="absolute inset-0 bg-success/5"></div>
							<div class="absolute inset-0 flex items-center justify-center">
								<div class="text-center">
									<div class="mx-auto mb-2 flex size-16 items-center justify-center rounded-full bg-background shadow-lg">
										<MapIcon class="text-success size-8" />
									</div>
									<p class="text-sm font-medium text-muted-foreground">Mapbox token required</p>
									<p class="text-xs text-muted-foreground/70 mt-1">Add PUBLIC_MAPBOX_TOKEN to your .env file</p>
								</div>
							</div>
						</div>
					)}
				</div>
				
				<div class="mt-10 text-center">
					<Button href="/parks-and-trails" variant="outline" size="lg" class="hover:bg-success hover:text-success-foreground hover:border-success transition-all no-underline">
						View All Parks & Trails
						<ArrowRight class="size-4" />
					</Button>
				</div>
			</Container>
		</Section>

		<!-- ============================================ -->
		<!-- 5. PARTNERS                                  -->
		<!-- ============================================ -->
		<Section id="partners" class="relative overflow-hidden bg-success/10">
			<Container class="relative z-10">
				<div class="mx-auto mb-16 max-w-2xl text-center">
					<Badge variant="info" class="mb-4">Community</Badge>
					<h2 class="text-3xl font-extrabold uppercase md:text-4xl">Our Partners</h2>
					<p class="text-muted-foreground mt-4 text-lg">
						Our community partners make the Wellness Passport possible. Pick up your passport or collect stamps at any of these participating locations.
					</p>
				</div>
			</Container>

			<!-- Edge-to-edge scrolling partners marquee - Two Rows -->
			<div class="relative overflow-hidden space-y-6 group py-6 px-4">
				<!-- Row 1 - scrolls left -->
				<div class="flex animate-marquee group-hover:paused">
					{[...partners, ...partners].map((partner, i) => {
						const slug = partner.slug?.current || (partner.title || 'partner').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')
						return (
							<a
								href={`/partners/${slug}`}
								class="flex flex-col items-center justify-center rounded-xl border border-border bg-background p-4 text-center mx-3 min-w-[200px] max-w-[200px] transition-all duration-300 hover:shadow-lg hover:scale-105 hover:border-primary/50 hover:bg-primary/5"
							>
								<p class="text-sm font-semibold leading-tight">{partner.title}</p>
								<Badge variant="default" class="mt-2 text-xs">{partner.partnerType || 'Partner'}</Badge>
							</a>
						)
					})}
				</div>
				<!-- Row 2 - scrolls right (reverse) -->
				<div class="flex animate-marquee group-hover:paused" style="animation-direction: reverse;">
					{[...partners.slice().reverse(), ...partners.slice().reverse()].map((partner, i) => {
						const slug = partner.slug?.current || (partner.title || 'partner').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')
						return (
							<a
								href={`/partners/${slug}`}
								class="flex flex-col items-center justify-center rounded-xl border border-border bg-background p-4 text-center mx-3 min-w-[200px] max-w-[200px] transition-all duration-300 hover:shadow-lg hover:scale-105 hover:border-primary/50 hover:bg-primary/5"
							>
								<p class="text-sm font-semibold leading-tight">{partner.title}</p>
								<Badge variant="default" class="mt-2 text-xs">{partner.partnerType || 'Partner'}</Badge>
							</a>
						)
					})}
				</div>
			</div>

			<Container class="relative z-10">
				<div class="mt-12 text-center">
					<Button href="/partners" variant="outline" size="lg" class="hover:bg-info hover:text-info-foreground hover:border-info transition-all">
						View All Partners
						<ArrowRight class="size-4" />
					</Button>
				</div>
			</Container>
		</Section>

		<!-- ============================================ -->
		<!-- 6. EVENTS                                    -->
		<!-- ============================================ -->
		<Section id="events" class="relative overflow-hidden bg-warning/5 py-16">
			<!-- Decorative topo pattern -->
			<div class="absolute inset-0 text-warning/4 pointer-events-none">
				<svg class="h-full w-full" xmlns="http://www.w3.org/2000/svg">
					<defs>
						<pattern id="topo-events" x="0" y="0" width="220" height="220" patternUnits="userSpaceOnUse">
							<path d="M 0 110 Q 55 90 110 110 T 220 110" fill="none" stroke="currentColor" stroke-width="0.8" opacity="0.2"/>
							<path d="M 0 55 Q 110 25 220 55" fill="none" stroke="currentColor" stroke-width="0.6" opacity="0.15"/>
							<path d="M 0 165 Q 110 195 220 165" fill="none" stroke="currentColor" stroke-width="0.6" opacity="0.15"/>
							<circle cx="180" cy="110" r="30" fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.1"/>
						</pattern>
					</defs>
					<rect width="100%" height="100%" fill="url(#topo-events)"/>
				</svg>
			</div>

			<Container class="relative z-10">
				<div class="mx-auto mb-16 max-w-2xl text-center">
					<Badge variant="warning" class="mb-4">Join Us</Badge>
					<h2 class="text-3xl font-extrabold uppercase md:text-4xl">Upcoming Events</h2>
					<p class="text-muted-foreground mt-4 text-lg">
						Monongalia County constantly has exciting, active events happening all around Morgantown and beyond.
					</p>
				</div>

				<div class="grid gap-6 sm:grid-cols-2">
					{upcomingEvents.map((event, i) => (
						<div
							class="group relative overflow-hidden rounded-2xl border border-border bg-card transition-all duration-300 hover:shadow-xl hover:-translate-y-1"
							style={`animation: fade-in-up 0.5s ease-out ${0.1 * i}s both;`}
						>
							<!-- Accent bar -->
							<div class="absolute left-0 top-0 bottom-0 w-1 bg-warning/0 transition-all duration-300 group-hover:bg-warning"></div>
							
							<!-- Decorative circle -->
							<div class="absolute -right-4 -top-4 size-20 bg-warning/5 rounded-full blur-xl transition-opacity group-hover:opacity-100 opacity-50"></div>
							
							<!-- Image placeholder -->
							<div class="bg-muted h-64 flex items-center justify-center relative overflow-hidden">
								<div class="absolute inset-0 bg-warning/5"></div>
								<div class="relative z-10 flex size-14 items-center justify-center rounded-full bg-background shadow-md">
									<Camera class="text-warning size-6" />
								</div>
							</div>
							
							<div class="relative p-6">
								<div class="mb-4 flex flex-wrap items-center gap-3">
									<div class="flex items-center gap-2 rounded-lg bg-warning/10 px-3 py-1.5">
										<Calendar class="text-warning size-4" />
										<span class="text-sm font-semibold text-warning">{event.date}</span>
									</div>
								</div>
								<h3 class="mb-2 text-xl font-bold group-hover:text-warning transition-colors">{event.title}</h3>
								<p class="text-muted-foreground mb-3 flex items-center gap-2 text-sm">
									<MapPin class="size-4 shrink-0 text-warning" />
									{event.location}
								</p>
								<p class="text-muted-foreground text-sm leading-relaxed">{event.description}</p>
							</div>
						</div>
					))}
				</div>

				<div class="mt-12 text-center">
					<Button href="/events" variant="outline" size="lg" class="hover:bg-warning hover:text-warning-foreground hover:border-warning transition-all">
						View Full Calendar
						<ArrowRight class="size-4" />
					</Button>
				</div>
			</Container>
		</Section>
	</main>
</Layout>
