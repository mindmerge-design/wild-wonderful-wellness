---
// Packages
import { SEO } from 'astro-seo'
import {
ArrowRight,
Award,
Map as MapIcon,
Mountain
} from 'lucide-astro'

// Components
import Badge from '@/components/elements/content/Badge.astro'
import PortableText from '@/components/elements/content/PortableText.astro'
import EventCard from '@/components/EventCard.astro'
import Container from '@/components/layout/Container.astro'
import Section from '@/components/layout/Section.astro'
import WaveDivider from '@/components/layout/WaveDivider.astro'
import ParkMap from '@/components/ParkMap.tsx'
import { Button } from '@/components/starwind/button'
import Layout from '@/layouts/Layout.astro'

// Sanity
import { loadQuery } from '@/sanity/lib/load-query'
import { featuredParksQuery, featuredPartnersQuery, homeQuery, upcomingEventsQuery } from '@/sanity/lib/queries'
import { urlForImage } from '@/sanity/lib/urlForImage'
import type { Event } from '@/sanity/schemaTypes/event'
import type { Home } from '@/sanity/schemaTypes/home'
import type { ParkTrail } from '@/sanity/schemaTypes/parkTrail'
import type { Partner } from '@/sanity/schemaTypes/partner'

// Load home page data
const { data: home } = await loadQuery<Home>({ query: homeQuery })

// Load featured parks from Sanity
const { data: featuredParks } = await loadQuery<ParkTrail[]>({ query: featuredParksQuery })
const parks = featuredParks || []

// Load featured partners from Sanity
const { data: featuredPartners } = await loadQuery<Partner[]>({ query: featuredPartnersQuery })
const partners = featuredPartners || []

// Load upcoming events from Sanity
const { data: upcomingEventsData } = await loadQuery<Event[]>({ query: upcomingEventsQuery })
const upcomingEvents = upcomingEventsData || []

const siteName = 'Wild & Wonderful Wellness'
const pageTitle = 'Wellness Passport'
const pageDescription =
	"Explore Monongalia County's parks, trails, and wellness activities. Collect stamps, earn rewards, and build healthier habits — one adventure at a time."

const mapboxToken = import.meta.env.PUBLIC_MAPBOX_TOKEN || ''

// Per-step color accents for "How It Works" — defined as full static strings for Tailwind scanning
const stepAccents = [
	{
		topBorder: 'border-t-primary',
		iconBg: 'bg-primary/10',
		numColor: 'text-primary/[0.07]',
		stepLabel: 'text-primary bg-primary/10'
	},
	{
		topBorder: 'border-t-secondary',
		iconBg: 'bg-secondary/10',
		numColor: 'text-secondary/[0.07]',
		stepLabel: 'text-secondary bg-secondary/10'
	},
	{
		topBorder: 'border-t-info',
		iconBg: 'bg-info/10',
		numColor: 'text-info/[0.07]',
		stepLabel: 'text-info bg-info/10'
	}
]

---

<Layout>
	<SEO
		title={`${pageTitle} | ${siteName}`}
		description={pageDescription}
		openGraph={{
			basic: {
				title: `${pageTitle} | ${siteName}`,
				type: 'website',
				image: ''
			}
		}}
		slot="head"
	/>

	<!-- ============================================ -->
	<!-- 1. HERO - Split Design with Diagonal Edge    -->
	<!-- ============================================ -->
	<div class="relative min-h-auto lg:min-h-[75vh] overflow-hidden bg-primary">

		<!-- Full-bleed hero image (desktop only) -->
		{home?.hero?.heroImage && (
			<div
				class="absolute inset-y-0 right-0 z-0 hidden lg:block md:left-[20%] lg:left-[25%]"
				style="mask-image: linear-gradient(to right, transparent 0%, black 60%); -webkit-mask-image: linear-gradient(to right, transparent 0%, black 60%);"
			>
				<img
					src={urlForImage(home.hero.heroImage).width(1920).height(1080).url()}
					alt=""
					width={1920}
					height={1080}
					class="h-full w-full object-cover object-left my-0!"
					aria-hidden="true"
				/>
			</div>
		)}

		<!-- Content -->
		<div class="relative z-10 flex flex-col lg:min-h-[75vh] lg:items-start lg:justify-center">
			<!-- Text content -->
			
				<Container class="pt-16 md:pt-0 text-center md:text-left max-w-2xl mx-auto pl-8 lg:pl-16 my-16">
					<div style="animation:fade-in-up 0.8s ease-out both;">
						<!-- Title -->
						<h1 class="mb-2 text-4xl lg:text-6xl xl:text-7xl font-extrabold leading-[1.1] tracking-tight text-white!">
							Wild &
							Wonderful
						</h1>

						<!-- Highlighted subtitle -->
						<div class="mt-3 lg:mt-4 inline-block -rotate-1 transform">
							<span class="inline-block rounded-lg bg-warning px-4 lg:px-6 py-1.5 lg:py-2 text-lg lg:text-2xl xl:text-3xl font-extrabold text-warning-foreground shadow-lg">
								Wellness Passport
							</span>
						</div>

						<!-- Tagline -->
						<p class="mt-6 lg:mt-8 text-xl lg:text-2xl font-semibold tracking-wide text-white/90!">
							Explore. Move. Earn Rewards.
						</p>

						<!-- CTA Button -->
						<div class="mt-6 lg:mt-8">
							<Button href="#introduction" variant="outline" size="lg" class="no-underline bg-white text-foreground hover:bg-white/90">
								Learn More
								<ArrowRight class="size-5" />
							</Button>
						</div>
					</div>
				</Container>
			

			<!-- Mobile-only image (stacks below text) -->
			<div class="block lg:hidden w-full h-[300px] sm:h-[400px]">
				{home?.hero?.heroImage ? (
					<img
						src={urlForImage(home.hero.heroImage).width(800).height(600).url()}
						alt={home.hero.heroImage.alt || 'Wellness Passport'}
						width={800}
						height={600}
						class="h-full w-full object-cover object-center my-0!"
					/>
				) : (
					<div class="h-full w-full bg-primary/50 flex items-center justify-center">
						<div class="text-center text-white/60">
							<Mountain class="size-16 mx-auto mb-4" />
							<p class="text-lg font-medium">Hero image coming soon</p>
						</div>
					</div>
				)}
			</div>
		</div>

		<WaveDivider class="z-30" />
	</div>

	<main id="main-content">
		<!-- ============================================ -->
		<!-- 2. INTRODUCTION                              -->
		<!-- ============================================ -->
		<Section id="introduction" class="relative overflow-hidden">
			<!-- Decorative topo pattern -->
			<div class="absolute inset-0 text-primary/5 pointer-events-none">
				<svg class="h-full w-full" xmlns="http://www.w3.org/2000/svg">
					<defs>
						<pattern id="topo-intro" x="0" y="0" width="300" height="300" patternUnits="userSpaceOnUse">
							<path d="M 0 150 Q 75 120 150 150 T 300 150" fill="none" stroke="currentColor" stroke-width="1" opacity="0.3"/>
							<path d="M 0 200 Q 100 170 200 200 T 300 200" fill="none" stroke="currentColor" stroke-width="0.8" opacity="0.2"/>
							<circle cx="250" cy="80" r="40" fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.15"/>
						</pattern>
					</defs>
					<rect width="100%" height="100%" fill="url(#topo-intro)"/>
				</svg>
			</div>

			<Container class="relative z-10">
				<div class="grid items-center gap-12 md:grid-cols-3">
					<div class="prose md:col-span-2">
						<PortableText portableText={home?.content} />
					</div>

					<!-- Stat Card — redesigned with more impact -->
					<div class="flex justify-center">
						<div class="relative w-full max-w-xs overflow-hidden rounded-3xl bg-gradient-to-br from-primary to-primary/80 p-7 text-center shadow-2xl">
							<!-- Large decorative ring -->
							<div class="absolute -top-12 -right-12 size-48 rounded-full border-2 border-dashed border-white/20 pointer-events-none" aria-hidden="true"></div>
							<div class="absolute -bottom-10 -left-10 size-36 rounded-full border border-white/15 pointer-events-none" aria-hidden="true"></div>

							<!-- Quarter pie visualization -->
							<div class="mb-5 flex justify-center">
								<div class="relative size-28">
									<div class="absolute inset-0 rounded-full bg-white/20"></div>
									<div
										class="absolute inset-0 rounded-full"
										style="background: conic-gradient(hsl(var(--warning)) 0deg 90deg, transparent 90deg 360deg);"
									></div>
									<div class="absolute inset-3 flex items-center justify-center rounded-full bg-white/95">
										<span class="text-primary font-black text-4xl">25%</span>
									</div>
								</div>
							</div>

							<!-- Stat numbers -->
							<div class="mb-3 flex items-baseline justify-center gap-2">
								<span class="text-warning font-black text-6xl drop-shadow-sm leading-none">1</span>
								<span class="text-white/60 text-3xl font-light">in</span>
								<span class="text-white! font-black text-6xl leading-none">4</span>
							</div>

							<p class="text-white! text-xs font-bold uppercase tracking-widest leading-relaxed">
								Mon County Residents<br/>are physically inactive<br/>outside of work
							</p>

							<!-- Decorative blobs -->
							<div class="absolute -right-6 -top-6 size-24 rounded-full bg-warning/30 blur-xl pointer-events-none" aria-hidden="true"></div>
							<div class="absolute -bottom-8 -left-8 size-32 rounded-full bg-white/10 blur-xl pointer-events-none" aria-hidden="true"></div>
						</div>
					</div>
				</div>
			</Container>
		</Section>

		<!-- Wave transition into "How It Works" -->
		<div class="relative -mb-1 overflow-hidden bg-background h-16 pointer-events-none" aria-hidden="true">
			<svg viewBox="0 0 1440 60" class="absolute bottom-0 w-full text-muted" preserveAspectRatio="none">
				<path fill="currentColor" d="M0,30 Q360,60 720,30 T1440,30 L1440,60 L0,60Z"/>
			</svg>
		</div>

		<!-- ============================================ -->
		<!-- 3. HOW IT WORKS                              -->
		<!-- ============================================ -->
		<Section id="how-it-works" class="bg-muted relative overflow-hidden">
			<!-- Topo pattern -->
			<div class="absolute inset-0 text-success/3 pointer-events-none">
				<svg class="h-full w-full" xmlns="http://www.w3.org/2000/svg">
					<defs>
						<pattern id="topo-how" x="0" y="0" width="250" height="250" patternUnits="userSpaceOnUse">
							<path d="M 0 125 Q 62.5 100 125 125 T 250 125" fill="none" stroke="currentColor" stroke-width="0.8" opacity="0.2"/>
							<path d="M 0 62.5 Q 125 25 250 62.5" fill="none" stroke="currentColor" stroke-width="0.6" opacity="0.15"/>
							<circle cx="200" cy="200" r="30" fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.1"/>
						</pattern>
					</defs>
					<rect width="100%" height="100%" fill="url(#topo-how)"/>
				</svg>
			</div>

			<Container class="relative z-10">
				<div class="mx-auto mb-16 max-w-2xl text-center">
					<Badge variant="primary" class="mb-4">Get Started</Badge>
					<h2 class="text-3xl font-extrabold md:text-4xl">How It Works</h2>
					<p class="text-muted-foreground mt-3 text-base leading-relaxed">Three easy steps to start your wellness adventure</p>
				</div>

				<!-- Three-step cards with per-step color coding + watermark numbers -->
				<div class="relative grid gap-8 md:grid-cols-3">

					<!-- Desktop connecting dashed path between steps -->
					<div class="absolute inset-x-0 top-12 hidden md:block pointer-events-none" aria-hidden="true">
						<div class="flex items-center px-[calc(16.66%+1rem)]">
							<div class="h-0 flex-1 border-t-2 border-dashed border-border/60"></div>
							<div class="mx-2 size-2 rounded-full bg-border/60"></div>
							<div class="h-0 flex-1 border-t-2 border-dashed border-border/60"></div>
						</div>
					</div>

					{(home?.howItWorks || []).map((step, i) => {
						const accent = stepAccents[i] || stepAccents[0]
						return (
							<div class="relative z-10" style={`animation: fade-in-up 0.6s ease-out ${0.15 * i}s both;`}>
								<div class={`relative overflow-hidden rounded-2xl border border-border border-t-4 ${accent.topBorder} bg-background text-center transition-all duration-300 hover:shadow-xl hover:-translate-y-1 shadow-md h-full`}>

									<!-- Watermark step number -->
									<span class={`absolute -right-2 -bottom-4 text-[8rem] font-black select-none pointer-events-none leading-none tabular-nums ${accent.numColor}`} aria-hidden="true">
										{String(i + 1).padStart(2, '0')}
									</span>

									<div class="relative p-6 md:p-8">
										<!-- Step pill label -->
										<div class="mb-4 flex justify-center">
											<span class={`inline-flex items-center rounded-full px-3 py-1 text-xs font-bold uppercase tracking-wider ${accent.stepLabel}`}>
												Step {i + 1}
											</span>
										</div>

										{step.hasIcon && step?.icon && (
											<div class={`mb-4 flex justify-center`}>
												<div class={`rounded-full ${accent.iconBg} p-3`} set:html={step.icon} />
											</div>
										)}
										<h3 class="mb-3 text-xl font-bold">{step.title}</h3>
										<div class="text-muted-foreground text-base leading-relaxed">
											<PortableText portableText={step.description} />
										</div>
									</div>
								</div>
							</div>
						)
					})}
				</div>

				<!-- Prizes teaser -->
				<div class="mt-10 relative overflow-hidden rounded-2xl border border-border bg-background p-8 text-center shadow-lg">
					<div class="absolute inset-0 bg-linear-to-br from-warning/5 to-success/5 pointer-events-none"></div>
					<div class="absolute -right-10 -top-10 size-40 bg-warning/10 rounded-full blur-3xl pointer-events-none"></div>
					<div class="absolute -left-10 -bottom-10 size-40 bg-success/10 rounded-full blur-3xl pointer-events-none"></div>
					<div class="relative z-10">
						<div class="mx-auto mb-4 flex size-14 items-center justify-center rounded-full bg-warning/10">
							<Award class="text-warning size-7" />
						</div>
						<div class="text-xl font-semibold text-foreground">
							<PortableText portableText={home?.pricesContent} />
						</div>
					</div>
				</div>

				<!-- Passport booklet placeholder -->
				<div class="mt-12 flex justify-center">
					<div class="w-full max-w-md overflow-hidden rounded-xl border-2 border-dashed border-border bg-background shadow-lg">
						<div class="bg-muted flex aspect-[3/2] items-center justify-center relative overflow-hidden">
							<div class="absolute inset-0 opacity-20">
								<svg class="h-full w-full" xmlns="http://www.w3.org/2000/svg">
									<defs>
										<pattern id="passport-pattern" x="0" y="0" width="40" height="40" patternUnits="userSpaceOnUse">
											<circle cx="20" cy="20" r="2" fill="currentColor"/>
										</pattern>
									</defs>
									<rect width="100%" height="100%" fill="url(#passport-pattern)"/>
								</svg>
							</div>
							<div class="relative z-10 text-center">
								<div class="mx-auto mb-3 flex size-16 items-center justify-center rounded-full bg-background shadow-md">
									<Mountain class="text-muted-foreground size-8" />
								</div>
								<p class="text-muted-foreground font-medium">Passport booklet photo coming soon</p>
							</div>
						</div>
						<div class="p-5 text-center bg-background">
							<p class="text-lg font-bold">Your Wellness Passport</p>
							<p class="text-muted-foreground mt-2 text-sm">Pick one up for free at MCHD or any partner location</p>
						</div>
					</div>
				</div>
			</Container>
		</Section>

		<!-- ============================================ -->
		<!-- 4. PARKS & TRAILS                            -->
		<!-- ============================================ -->
		<Section id="parks-trails" class="relative overflow-hidden py-16">
			<!-- Topo pattern -->
			<div class="absolute inset-0 text-success/4 pointer-events-none">
				<svg class="h-full w-full" xmlns="http://www.w3.org/2000/svg">
					<defs>
						<pattern id="topo-parks" x="0" y="0" width="200" height="200" patternUnits="userSpaceOnUse">
							<path d="M 0 100 Q 50 80 100 100 T 200 100" fill="none" stroke="currentColor" stroke-width="0.8" opacity="0.2"/>
							<path d="M 0 50 Q 100 20 200 50" fill="none" stroke="currentColor" stroke-width="0.6" opacity="0.15"/>
							<path d="M 0 150 Q 100 180 200 150" fill="none" stroke="currentColor" stroke-width="0.6" opacity="0.15"/>
							<circle cx="150" cy="100" r="35" fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.1"/>
						</pattern>
					</defs>
					<rect width="100%" height="100%" fill="url(#topo-parks)"/>
				</svg>
			</div>

			<Container class="relative z-10">
				<div class="mx-auto mb-8 max-w-3xl text-center">
					<Badge variant="success" class="mb-4">Explore</Badge>
					<h2 class="text-3xl font-extrabold md:text-4xl">Parks &amp; Trails</h2>
				</div>
				<div class="mx-auto mb-12 max-w-3xl">
					<p class="text-muted-foreground text-center text-lg leading-relaxed">
						There are over 30 parks and trails in Monongalia County waiting for you to explore. In each participating location, you will find a mounted lockbox with a custom self-inking stamp inside, which you can use to track your progress and earn credit in your passport.
					</p>
				</div>

				<!-- Full-width Interactive Map -->
				<div class="h-[540px] w-full">
					{mapboxToken ? (
						parks.length > 0 ? (
							<ParkMap parks={parks} mapboxToken={mapboxToken} client:only="react" />
						) : (
							<div class="relative overflow-hidden h-full rounded-2xl">
								<div class="absolute inset-0 bg-success/5"></div>
								<div class="absolute inset-0 flex items-center justify-center">
									<div class="text-center">
										<div class="mx-auto mb-2 flex size-16 items-center justify-center rounded-full bg-background shadow-lg">
											<MapIcon class="text-success size-8" />
										</div>
										<p class="text-sm font-medium text-muted-foreground">No parks to display</p>
										<p class="text-xs text-muted-foreground/70 mt-1">Add parks with coordinates in Sanity</p>
									</div>
								</div>
							</div>
						)
					) : (
						<div class="relative overflow-hidden h-full rounded-2xl">
							<div class="absolute inset-0 bg-success/5"></div>
							<div class="absolute inset-0 flex items-center justify-center">
								<div class="text-center">
									<div class="mx-auto mb-2 flex size-16 items-center justify-center rounded-full bg-background shadow-lg">
										<MapIcon class="text-success size-8" />
									</div>
									<p class="text-sm font-medium text-muted-foreground">Mapbox token required</p>
									<p class="text-xs text-muted-foreground/70 mt-1">Add PUBLIC_MAPBOX_TOKEN to your .env file</p>
								</div>
							</div>
						</div>
					)}
				</div>

				<div class="mt-10 text-center">
					<Button href="/parks-and-trails" variant="primary" size="lg" class="no-underline">
						View All Parks &amp; Trails
						<ArrowRight class="size-4" />
					</Button>
				</div>
			</Container>
		</Section>

		<!-- ============================================ -->
		<!-- 5. PARTNERS                                  -->
		<!-- ============================================ -->
		<Section id="partners" class="relative overflow-hidden bg-success/10">
			<Container class="relative z-10">
				<div class="mx-auto mb-16 max-w-2xl text-center">
					<Badge variant="default" class="mb-4">Community</Badge>
					<h2 class="text-3xl font-extrabold md:text-4xl">Our Partners</h2>
					<p class="text-muted-foreground mt-4 text-lg">
						Our community partners make the Wellness Passport possible. Pick up your passport or collect stamps at any of these participating locations.
					</p>
				</div>
			</Container>

			<!-- Edge-to-edge scrolling partners marquee — Two Rows -->
			<div class="relative overflow-hidden space-y-6 group py-6 px-4">
				<!-- Row 1 - scrolls left -->
				<div class="flex animate-marquee group-hover:paused">
					{[...partners, ...partners].map((partner) => {
						const slug = partner.slug?.current || (partner.title || 'partner').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')
						return (
							<a
								href={`/partners/${slug}`}
								class="flex flex-col items-center justify-center rounded-xl border border-border bg-background p-4 text-center mx-3 min-w-[200px] max-w-[200px] transition-all duration-300 hover:shadow-lg hover:scale-105 hover:border-primary/50 hover:bg-primary/5 no-underline"
							>
								<p class="text-sm font-semibold leading-tight">{partner.title}</p>
								<Badge variant="default" class="mt-2 text-xs">{partner.partnerType || 'Partner'}</Badge>
							</a>
						)
					})}
				</div>
				<!-- Row 2 - scrolls right -->
				<div class="flex animate-marquee group-hover:paused" style="animation-direction: reverse;">
					{[...partners.slice().reverse(), ...partners.slice().reverse()].map((partner) => {
						const slug = partner.slug?.current || (partner.title || 'partner').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')
						return (
							<a
								href={`/partners/${slug}`}
								class="flex flex-col items-center justify-center rounded-xl border border-border bg-background p-4 text-center mx-3 min-w-[200px] max-w-[200px] transition-all duration-300 hover:shadow-lg hover:scale-105 hover:border-primary/50 hover:bg-primary/5 no-underline"
							>
								<p class="text-sm font-semibold leading-tight">{partner.title}</p>
								<Badge variant="default" class="mt-2 text-xs">{partner.partnerType || 'Partner'}</Badge>
							</a>
						)
					})}
				</div>
			</div>

			<Container class="relative z-10">
				<div class="mt-12 text-center">
					<Button href="/partners" variant="primary" size="lg" class="no-underline">
						View All Partners
						<ArrowRight class="size-4" />
					</Button>
				</div>
			</Container>
		</Section>

		<!-- ============================================ -->
		<!-- 6. EVENTS                                    -->
		<!-- ============================================ -->
		<Section id="events" class="relative overflow-hidden py-16">
			<!-- Topo pattern -->
			<div class="absolute inset-0 text-warning/4 pointer-events-none">
				<svg class="h-full w-full" xmlns="http://www.w3.org/2000/svg">
					<defs>
						<pattern id="topo-events" x="0" y="0" width="220" height="220" patternUnits="userSpaceOnUse">
							<path d="M 0 110 Q 55 90 110 110 T 220 110" fill="none" stroke="currentColor" stroke-width="0.8" opacity="0.2"/>
							<path d="M 0 55 Q 110 25 220 55" fill="none" stroke="currentColor" stroke-width="0.6" opacity="0.15"/>
							<path d="M 0 165 Q 110 195 220 165" fill="none" stroke="currentColor" stroke-width="0.6" opacity="0.15"/>
						</pattern>
					</defs>
					<rect width="100%" height="100%" fill="url(#topo-events)"/>
				</svg>
			</div>

			<Container class="relative z-10">
				<div class="mx-auto mb-16 max-w-2xl text-center">
					<Badge variant="warning" class="mb-4">Join Us</Badge>
					<h2 class="text-3xl font-extrabold md:text-4xl">Upcoming Events</h2>
					<p class="text-muted-foreground mt-4 text-lg">
						Monongalia County constantly has exciting, active events happening all around Morgantown and beyond.
					</p>
				</div>

				<div class="grid gap-6 sm:grid-cols-2">
					{upcomingEvents.map((event, i) => (
						<EventCard event={event} index={i} variant="upcoming" />
					))}
				</div>

				<div class="mt-12 text-center">
					<Button href="/events" variant="primary" size="lg" class="no-underline">
						View Full Calendar
						<ArrowRight class="size-4" />
					</Button>
				</div>
			</Container>
		</Section>
	</main>
</Layout>
