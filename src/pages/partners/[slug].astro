---
// Packages
import type { GetStaticPaths } from 'astro'
import { SEO } from 'astro-seo'
import { Image } from 'astro:assets'
import {
	ArrowLeft,
	Award,
	Building2,
	Calendar,
	Clock,
	Globe,
	Heart,
	MapPin,
	Phone,
	Users
} from 'lucide-astro'

// Components
import Badge from '@/components/elements/content/Badge.astro'
import Card from '@/components/elements/content/Card.astro'
import PortableText from '@/components/elements/content/PortableText.astro'
import Container from '@/components/layout/Container.astro'
import Section from '@/components/layout/Section.astro'
import { Button } from '@/components/starwind/button'
import Layout from '@/layouts/Layout.astro'

// Sanity
import { loadQuery } from '@/sanity/lib/load-query'
import {
	allPartnersQuery,
	eventsByPartnerQuery,
	partnerBySlugQuery,
	settingsQuery
} from '@/sanity/lib/queries'
import { urlForImage } from '@/sanity/lib/urlForImage'

// Types
import type { Event } from '@/sanity/schemaTypes/event'
import type { Partner } from '@/sanity/schemaTypes/partner'
import type { SiteSettings } from '@/sanity/schemaTypes/siteSettings'

// Generate static paths for all partners
export const getStaticPaths = (async () => {
	const { data: partners } = await loadQuery<Partner[]>({
		query: allPartnersQuery
	})

	return partners.map((partner) => ({
		params: {
			slug:
				partner.slug?.current ||
				(partner.title || 'partner')
					.toLowerCase()
					.replace(/[^a-z0-9]+/g, '-')
					.replace(/^-|-$/g, '')
		}
	}))
}) satisfies GetStaticPaths

// Data
const { slug } = Astro.params
const { data: settings } = await loadQuery<SiteSettings>({ query: settingsQuery })
const { data: partner } = await loadQuery<Partner>({
	query: partnerBySlugQuery,
	params: { slug }
})

if (!partner) {
	return Astro.redirect('/404')
}

// Fetch related events
const { data: relatedEvents } = await loadQuery<Event[]>({
	query: eventsByPartnerQuery,
	params: { partnerId: partner._id }
})

const siteName = settings?.siteName || 'Wild & Wonderful Wellness'

// SEO
const seoTitle = partner.seo?.metaTitle || partner.title
const seoDescription = partner.seo?.metaDescription || partner.shortDescription || ''
const seoImage = partner.seo?.sharingImage
	? urlForImage(partner.seo.sharingImage).width(1200).height(630).url()
	: partner.mainImage
		? urlForImage(partner.mainImage).width(1200).height(630).url()
		: settings?.sharingImage
			? urlForImage(settings.sharingImage).width(1200).height(630).url()
			: ''

// Helper to format date
function formatDate(dateStr: string) {
	return new Date(dateStr).toLocaleDateString('en-US', {
		month: 'long',
		day: 'numeric',
		year: 'numeric'
	})
}

// Helper to format partner type
function formatPartnerType(type: string) {
	return type.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase())
}
---

<Layout>
	<SEO
		title={`${seoTitle} | ${siteName}`}
		description={seoDescription}
		openGraph={{
			basic: {
				title: `${seoTitle} | ${siteName}`,
				type: 'website',
				image: seoImage
			}
		}}
		slot="head"
	/>

	<!-- Hero Section -->
	<div class="bg-info relative min-h-[50vh] overflow-hidden">
		<!-- Decorative topo pattern overlay -->
		<div class="absolute inset-0 opacity-[0.08]">
			<svg class="h-full w-full" xmlns="http://www.w3.org/2000/svg">
				<defs>
					<pattern
						id="topo-partner-hero"
						x="0"
						y="0"
						width="200"
						height="200"
						patternUnits="userSpaceOnUse"
					>
						<path d="M 0 80 Q 50 60 100 80 T 200 80" fill="none" stroke="white" stroke-width="1"
						></path>
						<path
							d="M 0 100 Q 50 75 100 100 T 200 100"
							fill="none"
							stroke="white"
							stroke-width="0.8"></path>
						<circle cx="160" cy="40" r="20" fill="none" stroke="white" stroke-width="0.5"></circle>
					</pattern>
				</defs>
				<rect width="100%" height="100%" fill="url(#topo-partner-hero)"></rect>
			</svg>
		</div>

		<div class="absolute inset-0 bg-linear-to-b from-black/30 via-black/10 to-black/50"></div>

		<!-- Floating icons -->
		<div class="animate-pulse-soft absolute top-16 right-[12%] opacity-30" aria-hidden="true">
			<Building2 class="size-12 text-white!" />
		</div>
		<div
			class="animate-pulse-soft absolute bottom-20 left-[10%] opacity-25"
			style="animation-delay: 0.5s"
			aria-hidden="true"
		>
			<Heart class="size-10 text-white!" />
		</div>
		<div
			class="animate-pulse-soft absolute top-1/3 right-[25%] opacity-20"
			style="animation-delay: 1s"
			aria-hidden="true"
		>
			<Users class="size-11 text-white!" />
		</div>

		<Container class="relative z-10 flex min-h-[50vh] flex-col justify-center py-16">
			<div class="max-w-4xl" style="animation: fade-in-up 0.8s ease-out both;">
				<!-- Back link -->
				<a
					href="/partners"
					class="mb-6 inline-flex items-center gap-2 text-white/80 transition-colors hover:text-white"
				>
					<ArrowLeft class="size-4" />
					<span>Back to Partners</span>
				</a>

				<div class="flex items-start gap-6">
					<!-- Logo -->
					<div
						class="flex size-20 shrink-0 items-center justify-center rounded-2xl bg-white/20 backdrop-blur-sm"
					>
						{
							partner.logo ? (
								<Image
									src={urlForImage(partner.logo).width(80).height(80).url()}
									alt={partner.logo.alt || partner.title}
									width={80}
									height={80}
									class="size-12 object-contain"
								/>
							) : (
								<Building2 class="size-10 text-white!" />
							)
						}
					</div>

					<div>
						<div
							class="text-white!/95 mb-3 inline-flex items-center gap-2 rounded-full border border-white/30 bg-white/10 px-4 py-2 text-sm font-medium backdrop-blur-md"
						>
							<Award class="size-4 text-white!" />
							<span>Community Partner</span>
						</div>

						<h1 class="text-4xl font-extrabold tracking-tight text-white! md:text-5xl lg:text-6xl">
							{partner.title}
						</h1>

						{
							partner.partnerType && (
								<span class="mt-3 inline-flex items-center rounded-full bg-white/20 px-3 py-1 text-sm font-medium text-white! capitalize backdrop-blur-sm">
									{formatPartnerType(partner.partnerType)}
								</span>
							)
						}
					</div>
				</div>
			</div>
		</Container>

		<!-- Wave divider -->
		<div class="absolute right-0 -bottom-2 left-0 z-20">
			<svg viewBox="0 0 1440 200" class="text-background w-full" preserveAspectRatio="none">
				<path
					fill="currentColor"
					d="M0,96L48,112C96,128,192,160,288,160C384,160,480,128,576,122.7C672,117,768,139,864,154.7C960,171,1056,181,1152,165.3C1248,149,1344,107,1392,85.3L1440,64L1440,200L1392,200C1344,200,1248,200,1152,200C1056,200,960,200,864,200C768,200,672,200,576,200C480,200,384,200,288,200C192,200,96,200,48,200L0,200Z"
				></path>
			</svg>
		</div>
	</div>

	<main id="main-content">
		<Section>
			<Container>
				<div class="grid gap-12 lg:grid-cols-3">
					<!-- Main Content (2/3) -->
					<div class="lg:col-span-2">
						<!-- Logo Display -->
						{
							partner.logo && (
								<div class="mb-8">
									<Image
										src={urlForImage(partner.logo).width(300).height(200).url()}
										alt={partner.logo.alt || partner.title}
										width={300}
										height={200}
										class="h-24 w-auto object-contain"
									/>
								</div>
							)
						}

						<!-- Badges -->
						<div class="mb-6 flex flex-wrap gap-2">
							{
								partner.partnerType && (
									<Badge variant="primary">{formatPartnerType(partner.partnerType)}</Badge>
								)
							}
							{partner.hasPassportPickup && <Badge variant="success">Passport Pickup</Badge>}
							{partner.hasStampStation && <Badge variant="info">Stamp Station</Badge>}
						</div>

						<!-- Content -->
						{
							partner.content && (
								<div class="prose max-w-none">
									<PortableText portableText={partner.content} />
								</div>
							)
						}

						<!-- Related Events -->
						{
							relatedEvents && relatedEvents.length > 0 && (
								<div class="mt-12">
									<h2 class="mb-6 text-xl font-bold">Related Events</h2>
									<div class="space-y-4">
										{relatedEvents.map((event) => (
											<a href={`/events/${event.slug?.current}`} class="group block no-underline">
												<Card class="bg-card border-border border transition-shadow hover:shadow-md">
													<div class="flex items-center gap-3">
														<Calendar class="text-primary size-5 shrink-0" />
														<div>
															<h3 class="text-base font-semibold group-hover:underline">
																{event.title}
															</h3>
															<p class="text-muted-foreground text-sm">
																{formatDate(event.eventDate)}
																{event.location && ` - ${event.location}`}
															</p>
														</div>
														{event.isFree && (
															<Badge variant="success" class="ml-auto">
																Free
															</Badge>
														)}
													</div>
												</Card>
											</a>
										))}
									</div>
								</div>
							)
						}
					</div>

					<!-- Sidebar (1/3) -->
					<div class="lg:col-span-1">
						<div class="sticky top-8">
							<Card class="bg-card border-border border">
								<h3 class="mb-4 text-lg font-bold">Contact Information</h3>

								{/* Address */}
								{
									partner.address && (
										<div class="mb-4">
											<div class="mb-1 flex items-center gap-2">
												<MapPin class="text-primary size-4" />
												<span class="text-sm font-medium">Address</span>
											</div>
											<div class="text-muted-foreground ml-6 text-sm">
												<PortableText portableText={partner.address} />
											</div>
										</div>
									)
								}

								{/* Hours */}
								{
									partner.hours && (
										<div class="mb-4">
											<div class="mb-1 flex items-center gap-2">
												<Clock class="text-primary size-4" />
												<span class="text-sm font-medium">Hours</span>
											</div>
											<div class="text-muted-foreground ml-6 text-sm">
												<PortableText portableText={partner.hours} />
											</div>
										</div>
									)
								}

								{/* Phone */}
								{
									partner.phone && (
										<div class="mb-4">
											<div class="mb-1 flex items-center gap-2">
												<Phone class="text-primary size-4" />
												<span class="text-sm font-medium">Phone</span>
											</div>
											<a
												href={`tel:${partner.phone}`}
												class="text-primary ml-6 text-sm hover:underline"
											>
												{partner.phone}
											</a>
										</div>
									)
								}

								{/* Website */}
								{
									partner.websiteUrl && (
										<div class="mb-4">
											<div class="mb-1 flex items-center gap-2">
												<Globe class="text-primary size-4" />
												<span class="text-sm font-medium">Website</span>
											</div>
											<a
												href={partner.websiteUrl}
												target="_blank"
												rel="noopener noreferrer"
												class="text-primary ml-6 text-sm hover:underline"
											>
												Visit Website
												<span class="sr-only">(opens in new tab)</span>
											</a>
										</div>
									)
								}

								<div class="border-border mt-6 border-t pt-4">
									<Button href="/partners" variant="ghost" size="sm" class="w-full">
										<ArrowLeft class="size-4" />
										Back to Partners
									</Button>
								</div>
							</Card>
						</div>
					</div>
				</div>
			</Container>
		</Section>
	</main>
</Layout>
