---
// Packages
import type { GetStaticPaths } from 'astro'
import { SEO } from 'astro-seo'
import { Image } from 'astro:assets'
import {
ArrowLeft,
Calendar,
Clock,
Globe,
MapPin,
Phone
} from 'lucide-astro'

// Components
import Badge from '@/components/elements/content/Badge.astro'
import HeroBadge from '@/components/elements/content/HeroBadge.astro'
import PortableText from '@/components/elements/content/PortableText.astro'
import Container from '@/components/layout/Container.astro'
import Section from '@/components/layout/Section.astro'
import StampRings from '@/components/layout/StampRings.astro'
import WaveDivider from '@/components/layout/WaveDivider.astro'
import { Button } from '@/components/starwind/button'
import Layout from '@/layouts/Layout.astro'

// Sanity
import { loadQuery } from '@/sanity/lib/load-query'
import {
allPartnersQuery,
eventsByPartnerQuery,
partnerBySlugQuery,
settingsQuery
} from '@/sanity/lib/queries'
import { urlForImage } from '@/sanity/lib/urlForImage'

// Types
import type { Event } from '@/sanity/schemaTypes/event'
import type { Partner } from '@/sanity/schemaTypes/partner'
import type { SiteSettings } from '@/sanity/schemaTypes/siteSettings'

// Generate static paths for all partners
export const getStaticPaths = (async () => {
	const { data: partners } = await loadQuery<Partner[]>({
		query: allPartnersQuery
	})

	return partners.map((partner) => ({
		params: {
			slug:
				partner.slug?.current ||
				(partner.title || 'partner')
					.toLowerCase()
					.replace(/[^a-z0-9]+/g, '-')
					.replace(/^-|-$/g, '')
		}
	}))
}) satisfies GetStaticPaths

// Data
const { slug } = Astro.params
const { data: settings } = await loadQuery<SiteSettings>({ query: settingsQuery })
const { data: partner } = await loadQuery<Partner>({
	query: partnerBySlugQuery,
	params: { slug }
})

if (!partner) {
	return Astro.redirect('/404')
}

// Fetch related events
const { data: relatedEvents } = await loadQuery<Event[]>({
	query: eventsByPartnerQuery,
	params: { partnerId: partner._id }
})

const siteName = settings?.siteName || 'Wild & Wonderful Wellness'

// SEO
const seoTitle = partner.seo?.metaTitle || partner.title
const seoDescription = partner.seo?.metaDescription || partner.shortDescription || ''
const seoImage = partner.seo?.shareImage
	? urlForImage(partner.seo.shareImage).width(1200).height(630).url()
	: partner.mainImage
		? urlForImage(partner.mainImage).width(1200).height(630).url()
		: settings?.sharingImage
			? urlForImage(settings.sharingImage).width(1200).height(630).url()
			: ''

// Helper to format date
function formatDate(dateStr: string) {
	return new Date(dateStr).toLocaleDateString('en-US', {
		month: 'long',
		day: 'numeric',
		year: 'numeric'
	})
}

// Helper to format partner type
function formatPartnerType(type: string) {
	return type.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase())
}
---

<Layout>
	<SEO
		title={`${seoTitle} | ${siteName}`}
		description={seoDescription}
		openGraph={{
			basic: {
				title: `${seoTitle} | ${siteName}`,
				type: 'website',
				image: seoImage
			}
		}}
		slot="head"
	/>

	<!-- Hero Section -->
	<div class="bg-primary relative min-h-[50vh] overflow-hidden">
		<!-- Dot texture overlay -->
		<div
			class="absolute inset-0 opacity-40"
			style="background-image: radial-gradient(circle, rgba(255,255,255,0.08) 1px, transparent 1px); background-size: 24px 24px;"
			aria-hidden="true"
		></div>

		<!-- Decorative topo pattern overlay -->
		<div class="absolute inset-0 opacity-[0.07]" aria-hidden="true">
			<svg class="h-full w-full" xmlns="http://www.w3.org/2000/svg">
				<defs>
					<pattern
						id="topo-partner-hero"
						x="0"
						y="0"
						width="200"
						height="200"
						patternUnits="userSpaceOnUse"
					>
						<path d="M 0 80 Q 50 60 100 80 T 200 80" fill="none" stroke="white" stroke-width="1"
						></path>
						<path
							d="M 0 100 Q 50 75 100 100 T 200 100"
							fill="none"
							stroke="white"
							stroke-width="0.8"></path>
						<circle cx="160" cy="40" r="20" fill="none" stroke="white" stroke-width="0.5"></circle>
					</pattern>
				</defs>
				<rect width="100%" height="100%" fill="url(#topo-partner-hero)"></rect>
			</svg>
		</div>

		<div class="absolute inset-0 bg-linear-to-b from-black/30 via-black/10 to-black/50" aria-hidden="true"></div>

		<StampRings />

		<Container class="relative z-10 flex min-h-[50vh] flex-col justify-center py-16">
			<div class="max-w-4xl" style="animation: fade-in-up 0.8s ease-out both;">
				
				<div class="flex items-start gap-6">
					

					<div>
						<HeroBadge class="mb-3">Partners</HeroBadge>

						<h1 class="text-4xl font-extrabold tracking-tight text-white! md:text-5xl lg:text-6xl">
							{partner.title}
						</h1>

						
					</div>
				</div>
			</div>
		</Container>

		<WaveDivider />
	</div>

	<main id="main-content">
		<Section>
			<Container>
				<div class="grid gap-12 lg:grid-cols-3">
					<!-- Main Content (2/3) -->
					<div class="lg:col-span-2">
						<!-- Logo Display -->
						{
							partner.logo && (
								<div class="mb-8">
									<Image
										src={urlForImage(partner.logo).width(300).height(200).url()}
										alt={partner.logo.alt || partner.title}
										width={300}
										height={200}
										class="h-24 w-auto object-contain"
									/>
								</div>
							)
						}

						<!-- Badges -->
						<div class="mb-6 flex flex-wrap gap-2">
							{
								partner.partnerType && (
									<Badge variant="primary">{formatPartnerType(partner.partnerType)}</Badge>
								)
							}
							{partner.hasPassportPickup && <Badge variant="success">Passport Pickup</Badge>}
							{partner.hasStampStation && <Badge variant="info">Stamp Station</Badge>}
						</div>

						<!-- Content -->
						{
							partner.content && (
								<div class="prose max-w-none">
									<PortableText portableText={partner.content} />
								</div>
							)
						}

						<!-- Related Events -->
						{
							relatedEvents && relatedEvents.length > 0 && (
								<div class="mt-12">
									<h2 class="mb-6 text-xl font-bold">Related Events</h2>
									<div class="space-y-3">
										{relatedEvents.map((event) => (
											<a href={`/events/${event.slug?.current}`} class="group block no-underline">
												<div class="relative overflow-hidden rounded-xl border border-border bg-card transition-all duration-300 hover:shadow-md hover:border-primary/30 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary">
													<!-- Colored left indicator -->
													<div class="absolute left-0 top-0 bottom-0 w-1 bg-primary rounded-l-xl" aria-hidden="true"></div>

													<div class="flex items-center gap-4 p-4 pl-5">
														<div class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-primary/10">
															<Calendar class="text-primary size-5" />
														</div>
														<div class="flex-1 min-w-0">
															<h3 class="text-base font-semibold text-foreground group-hover:text-primary transition-colors group-hover:underline truncate">
																{event.title}
															</h3>
															<p class="text-muted-foreground text-sm mt-0.5">
																{formatDate(event.eventDate)}
																{event.location && ` — ${event.location}`}
															</p>
														</div>
														{event.isFree && (
															<Badge variant="success" class="shrink-0">
																Free
															</Badge>
														)}
													</div>
												</div>
											</a>
										))}
									</div>
								</div>
							)
						}
					</div>

					<!-- Sidebar (1/3) -->
					<div class="lg:col-span-1">
						<div class="sticky top-8">
							<div class="rounded-xl border border-border border-t-4 border-t-info bg-card shadow-sm overflow-hidden">
								<!-- Card header -->
								<div class="px-6 pt-5 pb-4">
									<h3 class="text-lg font-bold text-foreground flex items-center gap-2">
										<span class="flex size-7 items-center justify-center rounded-lg bg-info/10">
											<MapPin class="size-4 text-info" />
										</span>
										Contact Information
									</h3>
								</div>

								<div class="px-6 pb-5 space-y-0">
									{/* Address */}
									{
										partner.address && (
											<div class="py-4 border-t border-border first:border-t-0">
												<div class="mb-2 flex items-center gap-2">
													<MapPin class="size-4 text-info shrink-0" />
													<span class="text-xs font-semibold text-info uppercase tracking-wider">Address</span>
												</div>
												<div class="text-muted-foreground ml-6 text-sm leading-relaxed">
													<PortableText portableText={partner.address} />
												</div>
											</div>
										)
									}

									{/* Hours */}
									{
										partner.hours && (
											<div class="py-4 border-t border-border">
												<div class="mb-2 flex items-center gap-2">
													<Clock class="size-4 text-success shrink-0" />
													<span class="text-xs font-semibold text-success uppercase tracking-wider">Hours</span>
												</div>
												<div class="text-muted-foreground ml-6 text-sm leading-relaxed">
													<PortableText portableText={partner.hours} />
												</div>
											</div>
										)
									}

									{/* Phone */}
									{
										partner.phone && (
											<div class="py-4 border-t border-border">
												<div class="mb-2 flex items-center gap-2">
													<Phone class="size-4 text-warning shrink-0" />
													<span class="text-xs font-semibold text-warning uppercase tracking-wider">Phone</span>
												</div>
												<a
													href={`tel:${partner.phone}`}
													class="text-primary ml-6 text-sm hover:underline font-medium"
												>
													{partner.phone}
												</a>
											</div>
										)
									}

									{/* Website */}
									{
										partner.websiteUrl && (
											<div class="py-4 border-t border-border">
												<div class="mb-2 flex items-center gap-2">
													<Globe class="size-4 text-primary shrink-0" />
													<span class="text-xs font-semibold text-primary uppercase tracking-wider">Website</span>
												</div>
												<a
													href={partner.websiteUrl}
													target="_blank"
													rel="noopener noreferrer"
													class="text-primary ml-6 text-sm hover:underline font-medium"
												>
													Visit Website
													<span class="sr-only">(opens in new tab)</span>
												</a>
											</div>
										)
									}
								</div>

								<div class="border-t border-border px-6 py-4 bg-muted/30">
									<Button href="/partners" variant="ghost" size="sm" class="w-full no-underline">
										<ArrowLeft class="size-4" />
										Back to Partners
									</Button>
								</div>
							</div>
						</div>
					</div>
				</div>
			</Container>
		</Section>
	</main>
</Layout>
