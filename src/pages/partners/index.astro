---
// Packages
import { SEO } from 'astro-seo'
import { Award, Heart, MapPin, Users } from 'lucide-astro'

// Components
import Badge from '@/components/elements/content/Badge.astro'
import Container from '@/components/layout/Container.astro'
import Section from '@/components/layout/Section.astro'
import { Button } from '@/components/starwind/button'
import Layout from '@/layouts/Layout.astro'
import { loadQuery } from '@/sanity/lib/load-query'
import { allPartnersQuery } from '@/sanity/lib/queries'
import type { Partner } from '@/sanity/schemaTypes/partner'

// Fetch partners from Sanity
const { data: partners } = await loadQuery<Partner[]>({
	query: allPartnersQuery
})

const siteName = 'Wild & Wonderful Wellness'

// Stats
const healthPartners = partners.filter(p => ['healthcare', 'wellness'].includes(p.partnerType || '')).length
const fitnessPartners = partners.filter(p => ['fitness', 'recreation'].includes(p.partnerType || '')).length
const communityPartners = partners.filter(p => ['retail', 'other'].includes(p.partnerType || '')).length
const pickupLocations = partners.filter(p => p.hasPassportPickup).length

// SEO
const seoTitle = `Partners | ${siteName}`
const seoDescription = 'Community businesses and organizations supporting the Wellness Passport program. Pick up passports and collect stamps at participating locations.'
---

<Layout>
	<SEO
		title={seoTitle}
		description={seoDescription}
		openGraph={{
			basic: {
				title: seoTitle,
				type: 'website',
				image: ''
			}
		}}
		slot="head"
	/>

	<!-- Hero Section -->
	<div class="relative min-h-[45vh] overflow-hidden bg-primary">
		<!-- Dot texture overlay -->
		<div
			class="absolute inset-0 opacity-40"
			style="background-image: radial-gradient(circle, rgba(255,255,255,0.08) 1px, transparent 1px); background-size: 24px 24px;"
			aria-hidden="true"
		></div>

		<!-- Decorative topo pattern overlay -->
		<div class="absolute inset-0 opacity-[0.07]" aria-hidden="true">
			<svg class="h-full w-full" xmlns="http://www.w3.org/2000/svg">
				<defs>
					<pattern id="topo-partners-hero" x="0" y="0" width="200" height="200" patternUnits="userSpaceOnUse">
						<path d="M 0 80 Q 50 60 100 80 T 200 80" fill="none" stroke="white" stroke-width="1"/>
						<path d="M 0 100 Q 50 75 100 100 T 200 100" fill="none" stroke="white" stroke-width="0.8"/>
						<circle cx="160" cy="40" r="20" fill="none" stroke="white" stroke-width="0.5"/>
					</pattern>
				</defs>
				<rect width="100%" height="100%" fill="url(#topo-partners-hero)"/>
			</svg>
		</div>

		<div class="absolute inset-0 bg-linear-to-b from-black/20 via-black/10 to-black/40" aria-hidden="true"></div>

		<!-- Concentric stamp rings -->
		<div class="pointer-events-none absolute -right-24 top-1/2 -translate-y-1/2" aria-hidden="true">
			<div class="relative flex items-center justify-center size-[520px] rounded-full border border-dashed border-white/20">
				<div class="relative flex items-center justify-center size-[380px] rounded-full border border-dashed border-white/20">
					<div class="size-[240px] rounded-full border border-dashed border-white/20"></div>
				</div>
			</div>
		</div>

		<!-- Floating icons — right side only, clear of text -->
		<div class="absolute top-12 right-[4%] animate-pulse-soft opacity-15" aria-hidden="true">
			<Users class="text-white! size-9" />
		</div>
		<div class="absolute top-[45%] right-[18%] animate-pulse-soft opacity-10" style="animation-delay: 0.5s" aria-hidden="true">
			<Heart class="text-white! size-7" />
		</div>
		<div class="absolute bottom-24 right-[8%] animate-pulse-soft opacity-10" style="animation-delay: 1s" aria-hidden="true">
			<MapPin class="text-white! size-8" />
		</div>

		<Container class="relative z-10 flex min-h-[45vh] flex-col justify-center py-16">
			<div class="max-w-3xl" style="animation: fade-in-up 0.8s ease-out both;">
				<!-- Warning badge with pulsing dot -->
				<div class="mb-5 inline-flex items-center gap-2.5 rounded-full border border-warning/40 bg-warning/15 px-5 py-2.5 text-sm font-semibold text-warning backdrop-blur-md shadow-lg">
					<span class="size-2 rounded-full bg-warning animate-pulse-soft shrink-0" aria-hidden="true"></span>
					<span>Our Community</span>
				</div>

				<h1 class="text-4xl font-extrabold tracking-tight text-white! md:text-5xl lg:text-6xl">
					Community
					<span class="relative inline-block pb-2 text-accent">
						Partners
						<svg class="absolute -bottom-0.5 left-0 w-full overflow-visible pointer-events-none" viewBox="0 0 260 10" preserveAspectRatio="none" aria-hidden="true">
							<path d="M0,5 Q32.5,0 65,5 T130,5 T195,5 T260,5" fill="none" stroke-width="3" stroke-linecap="round" style="stroke: hsl(var(--accent))"/>
						</svg>
					</span>
				</h1>
				<p class="mt-5 text-xl text-white/90! max-w-2xl">
					Local businesses and organizations making wellness accessible for everyone. Pick up passports and collect stamps at these locations.
				</p>
			</div>
		</Container>

		<!-- Wave divider -->
		<div class="absolute -bottom-2 left-0 right-0" aria-hidden="true">
			<svg viewBox="0 0 1440 120" class="w-full text-background" preserveAspectRatio="none">
				<path fill="currentColor" d="M0,64L60,69.3C120,75,240,85,360,80C480,75,600,53,720,48C840,43,960,53,1080,64C1200,75,1320,85,1380,90L1440,96L1440,120L1380,120C1320,120,1200,120,1080,120C960,120,840,120,720,120C600,120,480,120,360,120C240,120,120,120,60,120L0,120Z"/>
			</svg>
		</div>
	</div>

	<main id="main-content">
		<!-- Stats Section -->
		<Section id="partner-stats" class="relative overflow-hidden py-8">
			<!-- Decorative topo pattern -->
			<div class="absolute inset-0 text-info/3 pointer-events-none" aria-hidden="true">
				<svg class="h-full w-full" xmlns="http://www.w3.org/2000/svg">
					<defs>
						<pattern id="topo-stats" x="0" y="0" width="200" height="200" patternUnits="userSpaceOnUse">
							<path d="M 0 100 Q 50 80 100 100 T 200 100" fill="none" stroke="currentColor" stroke-width="0.8" opacity="0.2"/>
							<circle cx="150" cy="100" r="35" fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.1"/>
						</pattern>
					</defs>
					<rect width="100%" height="100%" fill="url(#topo-stats)"/>
				</svg>
			</div>

			<Container class="relative z-10">
				<div class="grid grid-cols-2 md:grid-cols-4 gap-4">
					<!-- Total Partners -->
					<div class="rounded-xl border border-border border-t-4 border-t-info bg-card p-5 text-center shadow-sm transition-shadow hover:shadow-md">
						<div class="mx-auto mb-3 flex size-12 items-center justify-center rounded-full bg-info/10">
							<Users class="size-6 text-info" />
						</div>
						<p class="text-4xl font-black text-foreground leading-none mb-1">{partners.length}</p>
						<p class="text-xs font-medium text-muted-foreground uppercase tracking-wide">Total Partners</p>
					</div>

					<!-- Health Partners -->
					<div class="rounded-xl border border-border border-t-4 border-t-success bg-card p-5 text-center shadow-sm transition-shadow hover:shadow-md">
						<div class="mx-auto mb-3 flex size-12 items-center justify-center rounded-full bg-success/10">
							<Heart class="size-6 text-success" />
						</div>
						<p class="text-4xl font-black text-foreground leading-none mb-1">{healthPartners}</p>
						<p class="text-xs font-medium text-muted-foreground uppercase tracking-wide">Health Partners</p>
					</div>

					<!-- Fitness & Rec -->
					<div class="rounded-xl border border-border border-t-4 border-t-warning bg-card p-5 text-center shadow-sm transition-shadow hover:shadow-md">
						<div class="mx-auto mb-3 flex size-12 items-center justify-center rounded-full bg-warning/10">
							<Award class="size-6 text-warning" />
						</div>
						<p class="text-4xl font-black text-foreground leading-none mb-1">{fitnessPartners}</p>
						<p class="text-xs font-medium text-muted-foreground uppercase tracking-wide">Fitness &amp; Rec</p>
					</div>

					<!-- Pickup Locations -->
					<div class="rounded-xl border border-border border-t-4 border-t-primary bg-card p-5 text-center shadow-sm transition-shadow hover:shadow-md">
						<div class="mx-auto mb-3 flex size-12 items-center justify-center rounded-full bg-primary/10">
							<MapPin class="size-6 text-primary" />
						</div>
						<p class="text-4xl font-black text-foreground leading-none mb-1">{pickupLocations}</p>
						<p class="text-xs font-medium text-muted-foreground uppercase tracking-wide">Pickup Locations</p>
					</div>
				</div>
			</Container>
		</Section>

		<!-- Partners Grid Section -->
		<Section id="partners-listing" class="relative overflow-hidden">
			<!-- Decorative topo pattern -->
			<div class="absolute inset-0 text-info/2 pointer-events-none" aria-hidden="true">
				<svg class="h-full w-full" xmlns="http://www.w3.org/2000/svg">
					<defs>
						<pattern id="topo-partners-grid" x="0" y="0" width="200" height="200" patternUnits="userSpaceOnUse">
							<path d="M 0 100 Q 50 80 100 100 T 200 100" fill="none" stroke="currentColor" stroke-width="0.8" opacity="0.2"/>
							<circle cx="150" cy="100" r="35" fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.1"/>
						</pattern>
					</defs>
					<rect width="100%" height="100%" fill="url(#topo-partners-grid)"/>
				</svg>
			</div>

			<Container class="relative z-10">
				<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8">
					<div>
						<Badge variant="info" class="mb-2">Partners</Badge>
						<h2 class="text-2xl font-bold text-foreground">Our Community Partners</h2>
						<p class="text-muted-foreground mt-1">Organizations making wellness accessible</p>
					</div>

					<!-- Filter Tags -->
					<div class="flex flex-wrap gap-2">
						<button class="px-3 py-1.5 rounded-full bg-info text-info-foreground text-sm font-medium">All</button>
						<button class="px-3 py-1.5 rounded-full bg-muted text-muted-foreground text-sm font-medium hover:bg-muted/80 transition-colors">Health</button>
						<button class="px-3 py-1.5 rounded-full bg-muted text-muted-foreground text-sm font-medium hover:bg-muted/80 transition-colors">Fitness</button>
						<button class="px-3 py-1.5 rounded-full bg-muted text-muted-foreground text-sm font-medium hover:bg-muted/80 transition-colors">Community</button>
					</div>
				</div>

				<!-- Featured Partners (first 3) -->
				<div class="mb-8">
					<h3 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-4">Featured Partners</h3>
					<div class="grid md:grid-cols-3 gap-4">
						{partners.filter(p => p.featured).map((partner, i) => {
							const slug = partner.slug?.current || (partner.title || 'partner').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')
							return (
								<a
									href={`/partners/${slug}`}
									class="no-underline group relative rounded-xl border border-border bg-card overflow-hidden transition-all duration-300 hover:shadow-lg hover:border-info/40 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-info"
									style={`animation: fade-in-up 0.4s ease-out ${0.1 * i}s both;`}
								>
									<!-- Colored left accent bar, appears on hover -->
									<div class="absolute left-0 top-0 bottom-0 w-1.5 bg-info rounded-l-xl opacity-0 group-hover:opacity-100 transition-opacity duration-300" aria-hidden="true"></div>

									<div class="flex flex-col h-full">
										<!-- Header -->
										<div class="p-4 pb-2 pl-6">
											<div class="flex items-start gap-3">
									<div class="flex-1 min-w-0">
													<h4 class="font-bold text-foreground group-hover:text-info transition-colors">{partner.title}</h4>
													<span class="inline-flex items-center rounded-full bg-info/10 px-2 py-0.5 text-xs font-medium text-info capitalize mt-1">
														{partner.partnerType || 'Partner'}
													</span>
												</div>
											</div>
										</div>

										<!-- Content -->
										<div class="flex-1 p-4 pt-2 pl-6">
											<p class="text-muted-foreground text-sm leading-relaxed">{partner.shortDescription || ''}</p>
										</div>

										<!-- Services -->
										<div class="p-4 pt-0 pl-6">
											<div class="flex flex-wrap gap-1.5">
												{partner.hasPassportPickup && (
													<span class="inline-flex items-center rounded-md border border-border px-2 py-1 text-xs text-muted-foreground">
														Passport Pickup
													</span>
												)}
												{partner.offersDiscounts && (
													<span class="inline-flex items-center rounded-md border border-border px-2 py-1 text-xs text-muted-foreground">
														Discounts
													</span>
												)}
												{partner.hasStampStation && (
													<span class="inline-flex items-center rounded-md border border-border px-2 py-1 text-xs text-muted-foreground">
														Stamp Station
													</span>
												)}
											</div>
										</div>
									</div>
								</a>
							)
						})}
					</div>
				</div>

				<!-- All Partners -->
				<div>
					<h3 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-4">All Partners</h3>
					<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
						{partners.filter(p => !p.featured).map((partner, i) => {
							const slug = partner.slug?.current || (partner.title || 'partner').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')
							return (
								<a
									href={`/partners/${slug}`}
									class="no-underline group relative rounded-xl border border-border bg-card p-4 pl-5 transition-all duration-300 hover:shadow-md hover:border-info/30 overflow-hidden focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-info"
									style={`animation: fade-in-up 0.4s ease-out ${0.05 * i}s both;`}
								>
									<!-- Subtle colored left border on hover -->
									<div class="absolute left-0 top-0 bottom-0 w-1 bg-info rounded-l-xl opacity-0 group-hover:opacity-100 transition-opacity duration-300" aria-hidden="true"></div>

									<div class="flex items-start gap-3">
							<div class="flex-1 min-w-0">
											<h4 class="font-bold text-foreground text-sm group-hover:text-info transition-colors truncate">{partner.title}</h4>
											<p class="text-muted-foreground text-xs mt-1 line-clamp-2">{partner.shortDescription || ''}</p>
											<div class="flex flex-wrap gap-1 mt-2">
												<span class="inline-flex items-center rounded-full bg-info/10 px-2 py-0.5 text-[10px] font-medium text-info capitalize">
													{partner.partnerType || 'Partner'}
												</span>
												{partner.hasPassportPickup && (
													<span class="inline-flex items-center rounded-full bg-success/10 px-2 py-0.5 text-[10px] font-medium text-success">
														Pickup
													</span>
												)}
											</div>
										</div>
									</div>
								</a>
							)
						})}
					</div>
				</div>

				<!-- CTA -->
				<div class="mt-16">
					<div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-info to-info/80 p-8 md:p-12 text-center md:text-left shadow-xl">
						<!-- Dot texture overlay -->
						<div
							class="absolute inset-0 opacity-30"
							style="background-image: radial-gradient(circle, rgba(255,255,255,0.08) 1px, transparent 1px); background-size: 24px 24px;"
							aria-hidden="true"
						></div>

						<div class="relative z-10 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
							<div class="flex flex-col md:flex-row md:items-center gap-4 md:gap-6">
								<div class="mx-auto md:mx-0 flex size-16 items-center justify-center rounded-full bg-white/20">
									<Award class="text-white size-8" />
								</div>
								<div>
									<h3 class="font-bold text-white text-xl md:text-2xl">Want to become a partner?</h3>
									<p class="text-white/80 mt-1">Join our community of wellness advocates and help make a difference</p>
								</div>
							</div>
							<Button href="/contact" variant="outline" class="bg-white text-info border-white hover:bg-white/90 hover:text-info whitespace-nowrap text-base px-8 py-3 h-auto">
								Get in Touch
							</Button>
						</div>

						<!-- Decorative elements -->
						<div class="absolute -right-10 -top-10 size-40 rounded-full bg-white/10" aria-hidden="true"></div>
						<div class="absolute -bottom-10 -left-10 size-32 rounded-full bg-white/5" aria-hidden="true"></div>
					</div>
				</div>
			</Container>
		</Section>
	</main>
</Layout>
