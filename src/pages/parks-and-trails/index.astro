---
// Packages
import { SEO } from 'astro-seo'
import { Compass, Map as MapIcon, TreePine } from 'lucide-astro'

// Components
import Badge from '@/components/elements/content/Badge.astro'
import HeroBadge from '@/components/elements/content/HeroBadge.astro'
import Container from '@/components/layout/Container.astro'
import Section from '@/components/layout/Section.astro'
import StampRings from '@/components/layout/StampRings.astro'
import WaveDivider from '@/components/layout/WaveDivider.astro'
import ParkCard from '@/components/ParkCard.astro'
import ParkMap from '@/components/ParkMap.tsx'
import Layout from '@/layouts/Layout.astro'

// Sanity
import { loadQuery } from '@/sanity/lib/load-query'
import { allParksQuery } from '@/sanity/lib/queries'
import type { ParkTrail } from '@/sanity/schemaTypes/parkTrail'

// Load all parks from Sanity
const { data: allParks } = await loadQuery<ParkTrail[]>({ query: allParksQuery })
const parks = allParks || []

const siteName = 'Wild & Wonderful Wellness'
const mapboxToken = import.meta.env.PUBLIC_MAPBOX_TOKEN || ''

// SEO
const seoTitle = `Parks & Trails | ${siteName}`
const seoDescription =
	'Explore over 30 parks and trails in Monongalia County. Find stamp locations for your Wellness Passport.'
---

<Layout>
	<SEO
		title={seoTitle}
		description={seoDescription}
		openGraph={{
			basic: {
				title: seoTitle,
				type: 'website',
				image: ''
			}
		}}
		slot="head"
	/>

	<!-- Hero Section -->
	<div class="bg-primary relative min-h-[48vh] overflow-hidden">

		<!-- Dot texture overlay -->
		<div class="pointer-events-none absolute inset-0" aria-hidden="true" style="background-image: radial-gradient(circle, rgba(255,255,255,0.08) 1px, transparent 1px); background-size: 24px 24px;"></div>

		<!-- Gradient overlay -->
		<div class="absolute inset-0 bg-linear-to-b from-black/40 via-black/10 to-black/60"></div>

		<!-- Decorative topo pattern overlay -->
		<div class="absolute inset-0 opacity-[0.08]" aria-hidden="true">
			<svg class="h-full w-full" xmlns="http://www.w3.org/2000/svg">
				<defs>
					<pattern
						id="topo-parks-hero"
						x="0"
						y="0"
						width="200"
						height="200"
						patternUnits="userSpaceOnUse"
					>
						<path d="M 0 80 Q 50 60 100 80 T 200 80" fill="none" stroke="white" stroke-width="1"
						></path>
						<path
							d="M 0 100 Q 50 75 100 100 T 200 100"
							fill="none"
							stroke="white"
							stroke-width="0.8"></path>
						<circle cx="160" cy="40" r="20" fill="none" stroke="white" stroke-width="0.5"></circle>
					</pattern>
				</defs>
				<rect width="100%" height="100%" fill="url(#topo-parks-hero)"></rect>
			</svg>
		</div>

		<StampRings />

		<!-- Floating icons — right side only, clear of text -->
		<div class="animate-pulse-soft absolute top-12 right-[4%] opacity-15" aria-hidden="true">
			<TreePine class="size-10 text-white!" />
		</div>
		<div
			class="animate-pulse-soft absolute top-[45%] right-[16%] opacity-10"
			style="animation-delay: 0.5s"
			aria-hidden="true"
		>
			<MapIcon class="size-8 text-white!" />
		</div>
		<div
			class="animate-pulse-soft absolute bottom-24 right-[7%] opacity-10"
			style="animation-delay: 1s"
			aria-hidden="true"
		>
			<Compass class="size-9 text-white!" />
		</div>

		<Container class="relative z-10 flex min-h-[48vh] flex-col justify-center py-16">
			<div class="max-w-3xl" style="animation: fade-in-up 0.8s ease-out both;">

				<HeroBadge class="mb-6">Explore Monongalia County</HeroBadge>

				<h1 class="text-4xl font-extrabold tracking-tight text-white! md:text-5xl lg:text-6xl">
					Parks &amp;{' '}
					<!-- Squiggly underline under "Trails" -->
					<span class="relative inline-block pb-2">
						Trails
						<svg
							class="pointer-events-none absolute -bottom-0.5 left-0 w-full overflow-visible"
							viewBox="0 0 120 10"
							preserveAspectRatio="none"
							aria-hidden="true"
						>
							<path
								d="M0,5 Q15,0 30,5 T60,5 T90,5 T120,5"
								fill="none"
								stroke-width="3"
								stroke-linecap="round"
								style="stroke: hsl(var(--warning))"
							/>
						</svg>
					</span>
				</h1>

				<p class="mt-5 max-w-2xl text-xl text-white/90!">
					Discover over 30 outdoor destinations in the Wellness Passport program. Each location
					features a custom stamp for your passport.
				</p>
			</div>
		</Container>

		<!-- Organic wave divider -->
		<WaveDivider />
	</div>

	<main id="main-content">
		<!-- Map + Cards Split Section -->
		<Section id="parks-explorer" class="relative overflow-hidden py-8">
			<!-- Decorative topo pattern -->
			<div class="text-success/3 pointer-events-none absolute inset-0" aria-hidden="true">
				<svg class="h-full w-full" xmlns="http://www.w3.org/2000/svg">
					<defs>
						<pattern
							id="topo-explorer"
							x="0"
							y="0"
							width="200"
							height="200"
							patternUnits="userSpaceOnUse"
						>
							<path
								d="M 0 100 Q 50 80 100 100 T 200 100"
								fill="none"
								stroke="currentColor"
								stroke-width="0.8"
								opacity="0.2"></path>
							<circle
								cx="150"
								cy="100"
								r="35"
								fill="none"
								stroke="currentColor"
								stroke-width="0.5"
								opacity="0.1"></circle>
						</pattern>
					</defs>
					<rect width="100%" height="100%" fill="url(#topo-explorer)"></rect>
				</svg>
			</div>

			<Container class="relative z-10 space-y-12">
				<!-- Section header -->
				<div>
					<div class="mb-6 flex items-center justify-between">
						<div>
							<Badge variant="success" class="mb-3">Explore</Badge>
							<h2 class="text-3xl font-extrabold md:text-4xl">Explore Parks</h2>
						</div>
						<div class="flex gap-2" aria-label="Carousel navigation">
							<button
								id="carousel-prev"
								class="border-border bg-background hover:bg-success hover:text-success-foreground hover:border-success flex size-10 items-center justify-center rounded-full border shadow-sm transition-all"
								aria-label="Previous parks"
							>
								<svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										stroke-width="2"
										d="M15 19l-7-7 7-7"></path>
								</svg>
							</button>
							<button
								id="carousel-next"
								class="border-border bg-background hover:bg-success hover:text-success-foreground hover:border-success flex size-10 items-center justify-center rounded-full border shadow-sm transition-all"
								aria-label="Next parks"
							>
								<svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										stroke-width="2"
										d="M9 5l7 7-7 7"></path>
								</svg>
							</button>
						</div>
					</div>

					<div class="relative">
						<!-- Scrollable container -->
						<div
							id="parks-carousel"
							class="scrollbar-hide flex snap-x snap-mandatory gap-4 overflow-x-auto pb-4"
							style="scrollbar-width: none; -ms-overflow-style: none;"
						>
							{
								parks.length > 0 ? (
									parks.map((park, i) => (
										<div class="h-[380px] w-[320px] shrink-0 snap-start">
											<ParkCard park={park} index={i} size="md" />
										</div>
									))
								) : (
									<div class="flex h-48 w-full items-center justify-center">
										<p class="text-muted-foreground text-center">
											No parks found. Add some parks in Sanity to see them here.
										</p>
									</div>
								)
							}
						</div>
					</div>

					<!-- Carousel Navigation Script -->
					<script>
						document.addEventListener('astro:page-load', () => {
							const carousel = document.getElementById('parks-carousel')
							const prevBtn = document.getElementById('carousel-prev')
							const nextBtn = document.getElementById('carousel-next')

							if (carousel && prevBtn && nextBtn) {
								const scrollAmount = 336 // card width + gap

								prevBtn.addEventListener('click', () => {
									carousel.scrollBy({ left: -scrollAmount, behavior: 'smooth' })
								})

								nextBtn.addEventListener('click', () => {
									carousel.scrollBy({ left: scrollAmount, behavior: 'smooth' })
								})
							}
						})
					</script>
				</div>

				<!-- Full-width Map (below carousel) -->
				<div class="border-border h-[500px] w-full overflow-hidden rounded-2xl border-2 shadow-xl">
					{
						mapboxToken ? (
							parks.length > 0 ? (
								<ParkMap parks={parks} mapboxToken={mapboxToken} client:only="react" />
							) : (
								<div class="bg-muted flex h-full flex-col items-center justify-center p-8 text-center">
									<div class="bg-background mb-4 flex size-16 items-center justify-center rounded-full shadow-md">
										<MapIcon class="text-success size-8" />
									</div>
									<p class="text-muted-foreground font-medium">No parks to display</p>
									<p class="text-muted-foreground/70 mt-1 text-sm">
										Add parks with coordinates in Sanity
									</p>
								</div>
							)
						) : (
							<div class="bg-muted flex h-full flex-col items-center justify-center p-8 text-center">
								<div class="bg-background mb-4 flex size-16 items-center justify-center rounded-full shadow-md">
									<MapIcon class="text-success size-8" />
								</div>
								<p class="text-muted-foreground font-medium">Mapbox token required</p>
								<p class="text-muted-foreground/70 mt-1 text-sm">
									Add PUBLIC_MAPBOX_TOKEN to your .env file
								</p>
							</div>
						)
					}
				</div>
			</Container>
		</Section>
	</main>
</Layout>
