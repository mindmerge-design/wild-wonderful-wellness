---
// Packages
import { SEO } from 'astro-seo'
import { Compass, Map as MapIcon, TreePine } from 'lucide-astro'

// Components
import Container from '@/components/layout/Container.astro'
import Section from '@/components/layout/Section.astro'
import ParkCard from '@/components/ParkCard.astro'
import ParkMap from '@/components/ParkMap.tsx'
import Layout from '@/layouts/Layout.astro'

// Sanity
import { loadQuery } from '@/sanity/lib/load-query'
import { allParksQuery } from '@/sanity/lib/queries'
import type { ParkTrail } from '@/sanity/schemaTypes/parkTrail'

// Load all parks from Sanity
const { data: allParks } = await loadQuery<ParkTrail[]>({ query: allParksQuery })
const parks = allParks || []

const siteName = 'Wild & Wonderful Wellness'
const mapboxToken = import.meta.env.PUBLIC_MAPBOX_TOKEN || ''

// SEO
const seoTitle = `Parks & Trails | ${siteName}`
const seoDescription =
	'Explore over 30 parks and trails in Monongalia County. Find stamp locations for your Wellness Passport.'
---

<Layout>
	<SEO
		title={seoTitle}
		description={seoDescription}
		openGraph={{
			basic: {
				title: seoTitle,
				type: 'website',
				image: ''
			}
		}}
		slot="head"
	/>

	<!-- Hero Section -->
	<div class="bg-primary relative min-h-[40vh] overflow-hidden">
		<!-- Decorative topo pattern overlay -->
		<div class="absolute inset-0 opacity-[0.08]">
			<svg class="h-full w-full" xmlns="http://www.w3.org/2000/svg">
				<defs>
					<pattern
						id="topo-parks-hero"
						x="0"
						y="0"
						width="200"
						height="200"
						patternUnits="userSpaceOnUse"
					>
						<path d="M 0 80 Q 50 60 100 80 T 200 80" fill="none" stroke="white" stroke-width="1"
						></path>
						<path
							d="M 0 100 Q 50 75 100 100 T 200 100"
							fill="none"
							stroke="white"
							stroke-width="0.8"></path>
						<circle cx="160" cy="40" r="20" fill="none" stroke="white" stroke-width="0.5"></circle>
					</pattern>
				</defs>
				<rect width="100%" height="100%" fill="url(#topo-parks-hero)"></rect>
			</svg>
		</div>
		<div class="absolute inset-0 bg-linear-to-b from-black/30 via-black/10 to-black/50"></div>

		<!-- Floating icons -->
		<div class="animate-pulse-soft absolute top-12 right-[10%] opacity-30" aria-hidden="true">
			<TreePine class="size-11 text-white!" />
		</div>
		<div
			class="animate-pulse-soft absolute bottom-24 left-[8%] opacity-25"
			style="animation-delay: 0.5s"
			aria-hidden="true"
		>
			<MapIcon class="size-9 text-white!" />
		</div>
		<div
			class="animate-pulse-soft absolute top-1/3 right-[18%] opacity-20"
			style="animation-delay: 1s"
			aria-hidden="true"
		>
			<Compass class="size-10 text-white!" />
		</div>

		<Container class="relative z-10 flex min-h-[40vh] flex-col justify-center py-16">
			<div class="max-w-3xl" style="animation: fade-in-up 0.8s ease-out both;">
				<div
					class="text-white!/95 mb-4 inline-flex items-center gap-2 rounded-full border border-white/30 bg-white/10 px-4 py-2 text-sm font-medium backdrop-blur-md"
				>
					<TreePine class="size-4" />
					<span class="text-white!">Explore Monongalia County</span>
				</div>
				<h1 class="text-4xl font-extrabold tracking-tight text-white! md:text-5xl lg:text-6xl">
					Parks & <span class="text-accent">Trails</span>
				</h1>
				<p class="mt-4 max-w-2xl text-xl text-white/90!">
					Discover over 30 outdoor destinations in the Wellness Passport program. Each location
					features a custom stamp for your passport.
				</p>
			</div>
		</Container>

		<!-- Wave divider -->
		<div class="absolute right-0 -bottom-2 left-0">
			<svg viewBox="0 0 1440 120" class="text-background w-full" preserveAspectRatio="none">
				<path
					fill="currentColor"
					d="M0,64L60,69.3C120,75,240,85,360,80C480,75,600,53,720,48C840,43,960,53,1080,64C1200,75,1320,85,1380,90L1440,96L1440,120L1380,120C1320,120,1200,120,1080,120C960,120,840,120,720,120C600,120,480,120,360,120C240,120,120,120,60,120L0,120Z"
				></path>
			</svg>
		</div>
	</div>

	<main id="main-content">
		<!-- Map + Cards Split Section -->
		<Section id="parks-explorer" class="relative overflow-hidden py-8">
			<!-- Decorative topo pattern -->
			<div class="text-success/3 pointer-events-none absolute inset-0">
				<svg class="h-full w-full" xmlns="http://www.w3.org/2000/svg">
					<defs>
						<pattern
							id="topo-explorer"
							x="0"
							y="0"
							width="200"
							height="200"
							patternUnits="userSpaceOnUse"
						>
							<path
								d="M 0 100 Q 50 80 100 100 T 200 100"
								fill="none"
								stroke="currentColor"
								stroke-width="0.8"
								opacity="0.2"></path>
							<circle
								cx="150"
								cy="100"
								r="35"
								fill="none"
								stroke="currentColor"
								stroke-width="0.5"
								opacity="0.1"></circle>
						</pattern>
					</defs>
					<rect width="100%" height="100%" fill="url(#topo-explorer)"></rect>
				</svg>
			</div>

			<Container class="relative z-10 space-y-12">
				<!-- Horizontal Carousel Cards -->
				<div>
					<div class="mb-6 flex items-center justify-between">
						<h2 class="text-2xl font-bold">Explore Parks</h2>
						<div class="flex gap-2">
							<button
								id="carousel-prev"
								class="border-border bg-background hover:bg-success hover:text-success-foreground hover:border-success flex size-10 items-center justify-center rounded-full border shadow-sm transition-all"
								aria-label="Previous parks"
							>
								<svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										stroke-width="2"
										d="M15 19l-7-7 7-7"></path>
								</svg>
							</button>
							<button
								id="carousel-next"
								class="border-border bg-background hover:bg-success hover:text-success-foreground hover:border-success flex size-10 items-center justify-center rounded-full border shadow-sm transition-all"
								aria-label="Next parks"
							>
								<svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										stroke-width="2"
										d="M9 5l7 7-7 7"></path>
								</svg>
							</button>
						</div>
					</div>
					<div class="relative">
						<!-- Scrollable container -->
						<div
							id="parks-carousel"
							class="scrollbar-hide flex snap-x snap-mandatory gap-4 overflow-x-auto pb-4"
							style="scrollbar-width: none; -ms-overflow-style: none;"
						>
							{
								parks.length > 0 ? (
									parks.map((park, i) => (
										<div class="h-[380px] w-[320px] shrink-0 snap-start">
											<ParkCard park={park} index={i} size="md" />
										</div>
									))
								) : (
									<div class="flex h-48 w-full items-center justify-center">
										<p class="text-muted-foreground text-center">
											No parks found. Add some parks in Sanity to see them here.
										</p>
									</div>
								)
							}
						</div>
					</div>

					<!-- Carousel Navigation Script -->
					<script is:inline>
						document.addEventListener('DOMContentLoaded', () => {
							const carousel = document.getElementById('parks-carousel')
							const prevBtn = document.getElementById('carousel-prev')
							const nextBtn = document.getElementById('carousel-next')

							if (carousel && prevBtn && nextBtn) {
								const scrollAmount = 336 // card width + gap

								prevBtn.addEventListener('click', () => {
									carousel.scrollBy({ left: -scrollAmount, behavior: 'smooth' })
								})

								nextBtn.addEventListener('click', () => {
									carousel.scrollBy({ left: scrollAmount, behavior: 'smooth' })
								})
							}
						})
					</script>
				</div>

				<!-- Full-width Map (below carousel) -->
				<div class="border-border h-[500px] w-full overflow-hidden rounded-2xl border-2 shadow-xl">
					{
						mapboxToken ? (
							parks.length > 0 ? (
								<ParkMap parks={parks} mapboxToken={mapboxToken} client:only="react" />
							) : (
								<div class="bg-muted flex h-full flex-col items-center justify-center p-8 text-center">
									<div class="bg-background mb-4 flex size-16 items-center justify-center rounded-full shadow-md">
										<MapIcon class="text-success size-8" />
									</div>
									<p class="text-muted-foreground font-medium">No parks to display</p>
									<p class="text-muted-foreground/70 mt-1 text-sm">
										Add parks with coordinates in Sanity
									</p>
								</div>
							)
						) : (
							<div class="bg-muted flex h-full flex-col items-center justify-center p-8 text-center">
								<div class="bg-background mb-4 flex size-16 items-center justify-center rounded-full shadow-md">
									<MapIcon class="text-success size-8" />
								</div>
								<p class="text-muted-foreground font-medium">Mapbox token required</p>
								<p class="text-muted-foreground/70 mt-1 text-sm">
									Add PUBLIC_MAPBOX_TOKEN to your .env file
								</p>
							</div>
						)
					}
				</div>
			</Container>
		</Section>
	</main>
</Layout>
