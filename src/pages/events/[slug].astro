---
// Packages
import { SEO } from 'astro-seo'
import { Image } from 'astro:assets'
import {
ArrowLeft,
Building2,
Calendar,
Clock,
DollarSign,
ExternalLink,
MapPin,
Sparkles,
User
} from 'lucide-astro'

// Components
import Badge from '@/components/elements/content/Badge.astro'
import PortableText from '@/components/elements/content/PortableText.astro'
import Container from '@/components/layout/Container.astro'
import Section from '@/components/layout/Section.astro'
import StampRings from '@/components/layout/StampRings.astro'
import WaveDivider from '@/components/layout/WaveDivider.astro'
import Layout from '@/layouts/Layout.astro'

// Sanity
import { loadQuery } from '@/sanity/lib/load-query'
import { eventBySlugQuery, settingsQuery } from '@/sanity/lib/queries'
import { urlForImage } from '@/sanity/lib/urlForImage'

// Types
import HeroBadge from '@/components/elements/content/HeroBadge.astro'
import type { Event } from '@/sanity/schemaTypes/event'
import type { SiteSettings } from '@/sanity/schemaTypes/siteSettings'

// Data
const { slug } = Astro.params
const { data: settings } = await loadQuery<SiteSettings>({ query: settingsQuery })
const { data: event } = await loadQuery<Event>({
	query: eventBySlugQuery,
	params: { slug }
})

if (!event) {
	return Astro.redirect('/404')
}

const siteName = settings?.siteName || 'Wild & Wonderful Wellness'

// SEO
const seoTitle = event.seo?.metaTitle || event.title
const seoDescription = event.seo?.metaDescription || event.shortDescription || ''
const seoImage = event.seo?.shareImage
	? urlForImage(event.seo.shareImage).width(1200).height(630).url()
	: event.mainImage
		? urlForImage(event.mainImage).width(1200).height(630).url()
		: settings?.sharingImage
			? urlForImage(settings.sharingImage).width(1200).height(630).url()
			: ''

// Helpers
function formatDate(dateStr: string) {
	return new Date(dateStr).toLocaleDateString('en-US', {
		weekday: 'long',
		month: 'long',
		day: 'numeric',
		year: 'numeric'
	})
}

function formatTime(dateStr: string) {
	return new Date(dateStr).toLocaleTimeString('en-US', {
		hour: 'numeric',
		minute: '2-digit'
	})
}

function getEventMonth(dateStr: string) {
	return new Date(dateStr).toLocaleDateString('en-US', { month: 'short' })
}

function getEventDay(dateStr: string) {
	return new Date(dateStr).getDate().toString()
}

const isPast = new Date(event.eventDate) < new Date()
---

<Layout>
	<SEO
		title={`${seoTitle} | ${siteName}`}
		description={seoDescription}
		openGraph={{
			basic: {
				title: `${seoTitle} | ${siteName}`,
				type: 'website',
				image: seoImage
			}
		}}
		slot="head"
	/>

	<!-- Hero Section - Split Layout with Container -->
	<div class="bg-primary relative min-h-[auto] lg:min-h-[55vh] overflow-hidden">

		<!-- Dot texture overlay -->
		<div class="pointer-events-none absolute inset-0" aria-hidden="true" style="background-image: radial-gradient(circle, rgba(255,255,255,0.08) 1px, transparent 1px); background-size: 24px 24px;"></div>

		<StampRings class="z-10" />

		<!-- Floating decorative icon -->
		<div class="absolute top-10 left-[12%] z-[5] animate-pulse-soft opacity-20" aria-hidden="true">
			<Sparkles class="text-white! size-8" />
		</div>

		<Container class="relative z-10">
			<div class="flex flex-col lg:flex-row lg:min-h-[55vh] lg:-mx-4">
				<!-- Left side content -->
				<div class="relative z-20 flex flex-col justify-center py-12 lg:py-20 w-full lg:w-[55%] lg:px-4">
					<div style="animation: fade-in-up 0.8s ease-out both;">
						<HeroBadge class="mb-5">Events</HeroBadge>

						<h1 class="text-4xl font-extrabold tracking-tight text-white! md:text-5xl lg:text-6xl">
							{event.title}
						</h1>

						{event.shortDescription && (
							<p class="mt-4 max-w-2xl text-xl leading-relaxed text-white/90!">
								{event.shortDescription}
							</p>
						)}

						<!-- Quick date + location pills -->
						<div class="mt-6 flex flex-wrap gap-3">
							<div class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 text-sm font-medium text-white backdrop-blur-sm border border-white/20">
								<Calendar class="size-4 text-warning" aria-hidden="true" />
								{formatDate(event.eventDate)}
							</div>
							{event.location && (
								<div class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 text-sm font-medium text-white backdrop-blur-sm border border-white/20">
									<MapPin class="size-4 text-warning" aria-hidden="true" />
									{event.location}
								</div>
							)}
						</div>
					</div>
				</div>

				<!-- Right side image with 4/3 ratio -->
				<div class="relative w-full lg:w-[45%] lg:px-4 flex items-center">
					{event.mainImage ? (
						<div class="relative w-full aspect-4/3 overflow-hidden rounded-xl shadow-2xl">
							<Image
								src={urlForImage(event.mainImage).width(800).height(600).url()}
								alt={event.mainImage.alt || event.title}
								width={800}
								height={600}
								class="h-full w-full object-cover"
							/>
						</div>
					) : (
						<div class="w-full aspect-4/3 bg-warning/10 flex items-center justify-center rounded-xl border border-warning/20">
							<div class="text-center text-warning/40">
								<Calendar class="size-16 mx-auto mb-4" />
								<p class="text-lg font-medium">No image available</p>
							</div>
						</div>
					)}
				</div>
			</div>
		</Container>

		<WaveDivider />
	</div>

	<main id="main-content">
		<Section>
			<Container>
				<div class="grid gap-12 lg:grid-cols-3">
					<!-- Main Content (2/3) -->
					<div class="lg:col-span-2">
						<!-- Badges -->
						<div class="mb-6 flex flex-wrap gap-2">
							{event.isFree && <Badge variant="success">Free Event</Badge>}
							{!event.isFree && event.cost && <Badge variant="warning">{event.cost}</Badge>}
							{isPast && <Badge variant="default">Past Event</Badge>}
						</div>

						<!-- Portable Text Content -->
						{
							event.content && (
								<div class="prose max-w-none">
									<PortableText portableText={event.content} />
								</div>
							)
						}

						<!-- Hosted by Partner -->
						{
							event.relatedPartner && event.relatedPartner.title && (
								<div class="mt-10 overflow-hidden rounded-2xl border border-border bg-card">
									<!-- Colored top bar -->
									<div class="h-1 w-full bg-warning/70"></div>
									<div class="p-6">
										<div class="flex items-start gap-4">
											<div class="flex size-10 shrink-0 items-center justify-center rounded-xl border border-warning/20 bg-warning/10">
												<Building2 class="size-5 text-warning" aria-hidden="true" />
											</div>
											<div>
												<p class="text-xs font-bold uppercase tracking-widest text-muted-foreground mb-1">
													Hosted by
												</p>
												<a
													href={`/partners/${event.relatedPartner.slug?.current}`}
													class="text-base font-semibold text-foreground underline-offset-4 hover:text-warning hover:underline transition-colors"
												>
													{event.relatedPartner.title}
												</a>
											</div>
										</div>
									</div>
								</div>
							)
						}
					</div>

					<!-- Sidebar (1/3) -->
					<div class="lg:col-span-1">
						<div class="sticky top-8">
							<!-- Event Details Card -->
							<div class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
								<!-- Colored top border -->
								<div class="h-1 w-full bg-warning"></div>

								<div class="p-6">
									<h2 class="mb-5 text-lg font-bold">Event Details</h2>

									<div class="space-y-0 divide-y divide-border">
										{/* Date */}
										<div class="flex items-start gap-4 py-4 first:pt-0">
											<div class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-warning/10">
												<Calendar class="size-4 text-warning" aria-hidden="true" />
											</div>
											<div class="min-w-0 flex-1">
												<p class="text-xs font-bold uppercase tracking-widest text-muted-foreground mb-1">Date</p>
												<p class="text-sm font-medium text-foreground">
													{formatDate(event.eventDate)}
												</p>
												{
													event.endDate && (
														<p class="text-muted-foreground text-sm">
															to {formatDate(event.endDate)}
														</p>
													)
												}
											</div>
										</div>

										{/* Time */}
										<div class="flex items-start gap-4 py-4">
											<div class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-warning/10">
												<Clock class="size-4 text-warning" aria-hidden="true" />
											</div>
											<div class="min-w-0 flex-1">
												<p class="text-xs font-bold uppercase tracking-widest text-muted-foreground mb-1">Time</p>
												<p class="text-sm font-medium text-foreground">
													{formatTime(event.eventDate)}
													{event.endDate && ` – ${formatTime(event.endDate)}`}
												</p>
											</div>
										</div>

										{/* Location */}
										{
											event.location && (
												<div class="flex items-start gap-4 py-4">
													<div class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-warning/10">
														<MapPin class="size-4 text-warning" aria-hidden="true" />
													</div>
													<div class="min-w-0 flex-1">
														<p class="text-xs font-bold uppercase tracking-widest text-muted-foreground mb-1">Location</p>
														<p class="text-sm font-medium text-foreground">{event.location}</p>
														{event.address && (
															<p class="text-muted-foreground text-sm">{event.address}</p>
														)}
													</div>
												</div>
											)
										}

										{/* Organizer */}
										{
											event.organizer && (
												<div class="flex items-start gap-4 py-4">
													<div class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-warning/10">
														<User class="size-4 text-warning" aria-hidden="true" />
													</div>
													<div class="min-w-0 flex-1">
														<p class="text-xs font-bold uppercase tracking-widest text-muted-foreground mb-1">Organizer</p>
														<p class="text-sm font-medium text-foreground">{event.organizer}</p>
													</div>
												</div>
											)
										}

										{/* Cost */}
										<div class="flex items-start gap-4 py-4">
											<div class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-warning/10">
												<DollarSign class="size-4 text-warning" aria-hidden="true" />
											</div>
											<div class="min-w-0 flex-1">
												<p class="text-xs font-bold uppercase tracking-widest text-muted-foreground mb-1">Cost</p>
												<p class="text-sm font-medium text-foreground">
													{event.isFree ? 'Free' : event.cost || 'Contact organizer for details'}
												</p>
											</div>
										</div>
									</div>

									{/* Registration CTA */}
									{
										event.registrationUrl && !isPast && (
											<div class="mt-6">
												<a
													href={event.registrationUrl}
													target="_blank"
													rel="noopener noreferrer"
													class="group relative flex w-full items-center justify-center gap-2.5 overflow-hidden rounded-xl bg-warning px-6 py-4 text-base font-bold text-warning-foreground shadow-lg transition-all duration-300 hover:shadow-warning/30 hover:shadow-xl hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-warning no-underline"
													aria-label="Register for this event (opens in new tab)"
												>
													<!-- Shimmer effect -->
													<span class="absolute inset-0 -translate-x-full skew-x-12 bg-white/20 transition-transform duration-500 group-hover:translate-x-full" aria-hidden="true"></span>
													<span class="relative">Register Now</span>
													<ExternalLink class="relative size-4 transition-transform group-hover:scale-110" aria-hidden="true" />
												</a>
												<p class="mt-2 text-center text-xs text-muted-foreground">
													Opens registration in a new tab
												</p>
											</div>
										)
									}

									{/* Back link */}
									<div class="mt-5 border-t border-border pt-5">
										<a
											href="/events"
											class="flex w-full items-center justify-center gap-2 rounded-xl border border-border bg-background px-4 py-3 text-sm font-medium text-foreground transition-colors hover:bg-muted no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
										>
											<ArrowLeft class="size-4" aria-hidden="true" />
											Back to Events
										</a>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</Container>
		</Section>
	</main>
</Layout>
