---
// Packages
import { SEO } from 'astro-seo'
import { Calendar, Sparkles, Star } from 'lucide-astro'

// Components
import Badge from '@/components/elements/content/Badge.astro'
import HeroBadge from '@/components/elements/content/HeroBadge.astro'
import PortableText from '@/components/elements/content/PortableText.astro'
import EventCard from '@/components/EventCard.astro'
import Container from '@/components/layout/Container.astro'
import Section from '@/components/layout/Section.astro'
import StampRings from '@/components/layout/StampRings.astro'
import WaveDivider from '@/components/layout/WaveDivider.astro'
import Layout from '@/layouts/Layout.astro'

// Sanity
import { loadQuery } from '@/sanity/lib/load-query'
import { allEventsQuery, eventsPageQuery, settingsQuery } from '@/sanity/lib/queries'
import { urlForImage } from '@/sanity/lib/urlForImage'

// Types
import type { Event } from '@/sanity/schemaTypes/event'
import type { Events } from '@/sanity/schemaTypes/events'
import type { SiteSettings } from '@/sanity/schemaTypes/siteSettings'

// Data
const { data: settings } = await loadQuery<SiteSettings>({ query: settingsQuery })
const { data: allEvents } = await loadQuery<Event[]>({ query: allEventsQuery })
const { data: pageContent } = await loadQuery<Events>({ query: eventsPageQuery })

const siteName = settings?.siteName || 'Wild & Wonderful Wellness'

// Separate upcoming vs past events
const now = new Date().toISOString()
const upcomingEvents = (allEvents || []).filter((e) => e.eventDate >= now)
const pastEvents = (allEvents || []).filter((e) => e.eventDate < now).reverse()

// SEO
const seoTitle = `Events | ${siteName}`
const seoDescription = settings?.siteDescription || 'Browse upcoming and past wellness events.'
const seoImage = settings?.sharingImage
	? urlForImage(settings.sharingImage).width(1200).height(630).url()
	: ''

---

<Layout>
	<SEO
		title={seoTitle}
		description={seoDescription}
		openGraph={{
			basic: {
				title: seoTitle,
				type: 'website',
				image: seoImage
			}
		}}
		slot="head"
	/>

	<!-- Hero Section -->
	<div class="relative min-h-[48vh] overflow-hidden bg-primary">
		<!-- Dot texture overlay -->
		<div
			class="absolute inset-0 opacity-40"
			style="background-image: radial-gradient(circle, rgba(255,255,255,0.08) 1px, transparent 1px); background-size: 24px 24px;"
			aria-hidden="true"
		></div>

		<!-- Topo pattern overlay -->
		<div class="absolute inset-0 opacity-[0.07]" aria-hidden="true">
			<svg class="h-full w-full" xmlns="http://www.w3.org/2000/svg">
				<defs>
					<pattern id="topo-events-hero" x="0" y="0" width="200" height="200" patternUnits="userSpaceOnUse">
						<path d="M 0 80 Q 50 60 100 80 T 200 80" fill="none" stroke="white" stroke-width="1"/>
						<path d="M 0 100 Q 50 75 100 100 T 200 100" fill="none" stroke="white" stroke-width="0.8"/>
						<path d="M 0 120 Q 50 95 100 120 T 200 120" fill="none" stroke="white" stroke-width="0.6"/>
					</pattern>
				</defs>
				<rect width="100%" height="100%" fill="url(#topo-events-hero)"/>
			</svg>
		</div>

		<!-- Gradient overlay -->
		<div class="absolute inset-0 bg-linear-to-b from-black/20 via-black/10 to-black/60" aria-hidden="true"></div>

		<StampRings />

		<!-- Floating icons — right side only, clear of text -->
		<div class="absolute top-12 right-[4%] animate-pulse-soft opacity-15" aria-hidden="true">
			<Calendar class="text-white! size-9" />
		</div>
		<div class="absolute top-[45%] right-[18%] animate-pulse-soft opacity-10" style="animation-delay: 0.7s" aria-hidden="true">
			<Star class="text-white! size-7" />
		</div>
		<div class="absolute bottom-24 right-[8%] animate-pulse-soft opacity-10" style="animation-delay: 1.3s" aria-hidden="true">
			<Sparkles class="text-white! size-7" />
		</div>

		<Container class="relative z-10 flex min-h-[48vh] flex-col justify-center py-20">
			<div class="max-w-3xl" style="animation: fade-in-up 0.8s ease-out both;">
				<HeroBadge class="mb-6">Join the Community</HeroBadge>

				<h1 class="text-5xl font-extrabold tracking-tight text-white! md:text-6xl lg:text-7xl">
					Upcoming
					<span class="relative inline-block pb-2 text-accent">Events<svg class="absolute -bottom-0.5 left-0 w-full overflow-visible pointer-events-none" viewBox="0 0 200 10" preserveAspectRatio="none" aria-hidden="true"><path d="M0,5 Q25,0 50,5 T100,5 T150,5 T200,5" fill="none" stroke-width="3" stroke-linecap="round" style="stroke: hsl(var(--accent))"/></svg></span>
				</h1>
				<div class="mt-5 max-w-2xl text-lg prose-p:text-white/85!">
					<PortableText portableText={pageContent.content} />
				</div>
			</div>
		</Container>

		<WaveDivider />
	</div>

	<main id="main-content">
		<!-- Upcoming Events -->
		<Section id="upcoming-events" class="relative overflow-hidden">
			<!-- Subtle dot texture -->
			<div
				class="absolute inset-0 opacity-[0.03] pointer-events-none"
				style="background-image: radial-gradient(circle, hsl(var(--warning)) 1px, transparent 1px); background-size: 28px 28px;"
				aria-hidden="true"
			></div>

			<Container class="relative z-10">
				<div class="mb-12">
					<Badge variant="warning" class="mb-4">Mark Your Calendar</Badge>
					<h2 class="text-4xl font-extrabold md:text-5xl lg:text-6xl mt-6!">Upcoming<br/>Events</h2>

					<!-- Page Content from Sanity -->
					{pageContent?.content && (
						<div class="mt-6 prose prose-lg max-w-3xl text-muted-foreground">
							<PortableText portableText={pageContent.getStamps} />
						</div>
					)}
				</div>

				{
					upcomingEvents.length > 0 ? (
						<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
							{upcomingEvents.map((event, i) => (
								<EventCard event={event} index={i} variant="upcoming" />
							))}
						</div>
					) : (
						<div class="mx-auto max-w-sm py-20 text-center">
							<div class="mx-auto mb-5 flex size-16 items-center justify-center rounded-2xl border border-warning/20 bg-warning/10">
								<Calendar class="text-warning size-8" aria-hidden="true" />
							</div>
							<p class="text-foreground font-semibold text-lg mb-2">Nothing scheduled yet</p>
							<p class="text-muted-foreground">
								No upcoming events at this time — check back soon!
							</p>
						</div>
					)
				}
			</Container>
		</Section>

		<!-- Past Events -->
		{
			pastEvents.length > 0 && (
				<Section id="past-events" class="bg-muted relative overflow-hidden">
					<!-- Subtle dot texture -->
					<div
						class="absolute inset-0 opacity-[0.04] pointer-events-none"
						style="background-image: radial-gradient(circle, hsl(var(--primary)) 1px, transparent 1px); background-size: 24px 24px;"
						aria-hidden="true"
					></div>

					<Container class="relative z-10">
						<div class="mb-12">
							<Badge variant="primary" class="mb-4">Looking Back</Badge>
							<h2 class="text-4xl font-extrabold md:text-5xl">Past Events</h2>
							<p class="text-muted-foreground mt-4 text-lg">
								Relive the moments from our previous wellness gatherings.
							</p>
						</div>

						<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
							{pastEvents.map((event, i) => (
								<EventCard event={event} index={i} variant="past" />
							))}
						</div>
					</Container>
				</Section>
			)
		}
	</main>
</Layout>
