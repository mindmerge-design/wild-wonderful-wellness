---
// Components
import { navigationConfig } from '@/components/config/navigation.ts'
import Container from '@/components/layout/Container.astro'
import Logo from '@/components/elements/navigation/Logo.astro'
import { Award } from 'lucide-astro'

// Assets

// Misc
const { class: className, ...rest } = Astro.props
const pathname = Astro.url.pathname
---

<header class="sticky top-0 z-40 w-full">
	<div
		class="bg-primary/95 supports-[backdrop-filter]:bg-primary/90 border-primary-foreground/10 border-b backdrop-blur transition-all duration-300"
	>
		<Container>
			<div class="flex h-28 items-center justify-between">
				<!-- Logo -->
				<a href="/" class="flex items-center no-underline">
					<Logo class="h-24 w-auto md:h-28" />
				</a>

				<!-- Desktop Navigation -->
				<nav class="hidden items-center gap-1 md:flex">
					{
						navigationConfig.map((item) => (
							<a
								href={item.href}
								class="text-primary-foreground/80 hover:text-primary-foreground hover:bg-primary-foreground/10 flex items-center rounded-md px-3 py-2 text-base font-bold no-underline transition-colors"
							>
								{item.label}
							</a>
						))
					}
					<a
						href="/#how-it-works"
						class="bg-warning hover:bg-warning/90 ml-2 inline-flex items-center gap-1.5 rounded-full px-4 py-2 text-base font-bold text-white! no-underline transition-colors"
					>
						Get Passport
					</a>
				</nav>

				<!-- Mobile Menu Button -->
				<button
					type="button"
					id="mobile-menu-btn"
					class="text-primary-foreground hover:bg-primary-foreground/10 inline-flex items-center justify-center rounded-md p-2 md:hidden"
					aria-label="Toggle menu"
					aria-expanded="false"
					aria-controls="mobile-nav"
				>
					<svg id="menu-icon" class="size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="M4 6h16M4 12h16M4 18h16"></path>
					</svg>
					<svg
						id="close-icon"
						class="hidden size-6"
						fill="none"
						stroke="currentColor"
						viewBox="0 0 24 24"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="M6 18L18 6M6 6l12 12"></path>
					</svg>
				</button>
			</div>

			<!-- Mobile Navigation (hidden by default) -->
			<nav
				id="mobile-nav"
				class="bg-background relative z-50 mt-24 hidden rounded-lg p-4 shadow-lg md:hidden"
			>
				<div class="flex flex-col gap-1">
					{
						navigationConfig.map((item) => (
							<a
								href={item.href}
								class="text-muted-foreground hover:text-foreground hover:bg-muted flex items-center rounded-md px-3 py-2.5 text-base font-bold no-underline"
							>
								{item.label}
							</a>
						))
					}
					<a
						href="/#how-it-works"
						class="bg-warning mt-2 flex items-center justify-center gap-1.5 rounded-full px-4 py-2.5 text-base font-bold text-white no-underline"
					>
						<Award class="size-4" />
						Get Passport
					</a>
				</div>
			</nav>
		</Container>
	</div>
</header>

<script>
	function initMobileNav() {
		const btn = document.getElementById('mobile-menu-btn')
		const nav = document.getElementById('mobile-nav')
		const menuIcon = document.getElementById('menu-icon')
		const closeIcon = document.getElementById('close-icon')

		if (!btn || !nav) return

		// Ensure menu starts closed on every page load
		nav.classList.add('hidden')
		btn.setAttribute('aria-expanded', 'false')
		menuIcon?.classList.remove('hidden')
		closeIcon?.classList.add('hidden')

		btn.addEventListener('click', () => {
			const isExpanded = btn.getAttribute('aria-expanded') === 'true'
			btn.setAttribute('aria-expanded', String(!isExpanded))
			nav.classList.toggle('hidden')
			menuIcon?.classList.toggle('hidden')
			closeIcon?.classList.toggle('hidden')
		})

		// Close menu when a nav link is clicked
		nav.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => {
				nav.classList.add('hidden')
				btn.setAttribute('aria-expanded', 'false')
				menuIcon?.classList.remove('hidden')
				closeIcon?.classList.add('hidden')
			})
		})
	}

	document.addEventListener('astro:page-load', initMobileNav)
</script>
