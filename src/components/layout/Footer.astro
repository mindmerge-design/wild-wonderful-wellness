---
// Components
import { footerConfig, navigationConfig, socialLinks } from '@/components/config/navigation'
import Container from '@/components/layout/Container.astro'
import { loadQuery } from '@/sanity/lib/load-query'
import { settingsQuery } from '@/sanity/lib/queries'
import type { SiteSettings } from '@/sanity/schemaTypes/siteSettings'
import { Image } from 'astro:assets'

// Icons
import { Mail, MapPin, Phone } from 'lucide-astro'

// Misc
const d = new Date()
const n = d.getFullYear()
const { data: settings } = await loadQuery<SiteSettings>({ query: settingsQuery })

// Group navigation into columns
const exploreLinks = navigationConfig.slice(0, 3)
const connectLinks = navigationConfig.slice(3)
---

<footer class="bg-primary text-primary-foreground relative overflow-hidden">
	<!-- Wave divider at top of footer -->
	<div
		class="pointer-events-none absolute top-0 right-0 left-0"
		aria-hidden="true"
		style="transform: rotate(180deg);"
	>
		<svg
			viewBox="0 0 1440 60"
			class="text-background w-full fill-current"
			preserveAspectRatio="none"
			style="display: block;"
		>
			<path d="M0,30 Q360,60 720,30 T1440,30 L1440,60 L0,60Z"></path>
		</svg>
	</div>

	<!-- Large Fraunces watermark -->
	<div
		class="pointer-events-none absolute right-0 bottom-0 overflow-hidden select-none"
		aria-hidden="true"
	>
		<p
			class="text-primary-foreground text-right leading-[0.85] font-black"
			style="font-size: clamp(5rem, 14vw, 14rem); font-family: 'Fraunces', Georgia, serif; opacity: 0.04; white-space: nowrap;"
		>
			Wild &amp;<br />Wonderful
		</p>
	</div>

	<!-- Decorative organic pattern -->
	<div class="pointer-events-none absolute inset-0 opacity-[0.06]" aria-hidden="true">
		<svg class="h-full w-full" xmlns="http://www.w3.org/2000/svg">
			<defs>
				<pattern
					id="footer-pattern"
					x="0"
					y="0"
					width="100"
					height="100"
					patternUnits="userSpaceOnUse"
				>
					<path
						d="M50 20 Q60 10 70 20 T90 20"
						fill="none"
						stroke="currentColor"
						stroke-width="1"
						opacity="0.5"></path>
					<circle
						cx="20"
						cy="50"
						r="8"
						fill="none"
						stroke="currentColor"
						stroke-width="0.8"
						opacity="0.4"></circle>
					<circle cx="80" cy="70" r="5" fill="currentColor" opacity="0.3"></circle>
					<path
						d="M10 80 Q30 70 50 80"
						fill="none"
						stroke="currentColor"
						stroke-width="0.8"
						opacity="0.4"></path>
				</pattern>
			</defs>
			<rect width="100%" height="100%" fill="url(#footer-pattern)"></rect>
		</svg>
	</div>

	<Container class="relative z-10 pt-20">
		<!-- Main footer content -->
		<div class="grid gap-12 py-16 md:grid-cols-2 lg:grid-cols-4">
			<!-- Brand column -->
			<div class="space-y-6">
				<div class="flex items-center gap-3">
					<Image
						src="/images/logo.png"
						alt="Wellness Passport"
						width={140}
						height={140}
						class="h-24 w-auto md:h-32"
					/>
				</div>
				<p class="text-primary-foreground/60 mt-3 max-w-[200px] text-sm leading-relaxed">
					Exploring Monongalia County one stamp at a time.
				</p>
			</div>

			<!-- Explore column -->
			<div class="space-y-4">
				<h4
					class="text-primary-foreground/90 flex items-center text-sm font-semibold tracking-wider uppercase"
				>
					<span class="bg-warning/60 mr-1.5 inline-block size-1.5 rounded-full" aria-hidden="true"
					></span>
					Explore
				</h4>
				<ul class="space-y-3">
					{
						exploreLinks.map((item) => (
							<li>
								<a
									href={item.href}
									class="text-primary-foreground/70 hover:text-primary-foreground inline-flex items-center gap-2 text-sm transition-colors"
								>
									{item.label}
								</a>
							</li>
						))
					}
					<li>
						<a
							href="/partners"
							class="text-primary-foreground/70 hover:text-primary-foreground inline-flex items-center gap-2 text-sm transition-colors"
						>
							Partners
						</a>
					</li>
				</ul>
			</div>

			<!-- Contact column -->
			<div class="space-y-4">
				<h4
					class="text-primary-foreground/90 flex items-center text-sm font-semibold tracking-wider uppercase"
				>
					<span class="bg-warning/60 mr-1.5 inline-block size-1.5 rounded-full" aria-hidden="true"
					></span>
					Contact
				</h4>
				<ul class="space-y-3">
					<li class="flex items-start gap-3 text-sm">
						<MapPin class="text-primary-foreground/70 mt-0.5 size-4 shrink-0" aria-hidden="true" />
						<span class="text-primary-foreground/70">
							Monongalia County<br />Health Department<br />Morgantown, WV 26505
						</span>
					</li>
					<li class="flex items-center gap-3 text-sm">
						<Phone class="text-primary-foreground/70 size-4 shrink-0" aria-hidden="true" />
						<a
							href="tel:3045985100"
							class="text-primary-foreground/70 hover:text-primary-foreground transition-colors"
						>
							(304) 598-5100
						</a>
					</li>
					<li class="flex items-center gap-3 text-sm">
						<Mail class="text-primary-foreground/70 size-4 shrink-0" aria-hidden="true" />
						<a
							href="mailto:wellness@monongaliahealth.org"
							class="text-primary-foreground/70 hover:text-primary-foreground transition-colors"
						>
							wellness@monongaliahealth.org
						</a>
					</li>
				</ul>
			</div>

			<!-- Connect column -->
			<div class="space-y-4">
				<h4
					class="text-primary-foreground/90 flex items-center text-sm font-semibold tracking-wider uppercase"
				>
					<span class="bg-warning/60 mr-1.5 inline-block size-1.5 rounded-full" aria-hidden="true"
					></span>
					Connect
				</h4>

				<!-- Social links -->
				{
					socialLinks.length > 0 && (
						<div class="flex gap-3 pt-2">
							{socialLinks.map((social) => (
								<a
									href={social.url}
									target="_blank"
									rel="noopener noreferrer"
									class="bg-primary-foreground/10 hover:bg-primary-foreground/20 rounded-xl p-3 transition-colors"
									aria-label={`Follow us on ${social.platform}`}
								>
									<span class="sr-only">{social.platform}</span>
									{social.platform === 'facebook' && (
										<svg class="size-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
											<path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
										</svg>
									)}
									{social.platform === 'twitter' && (
										<svg class="size-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
											<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
										</svg>
									)}
									{social.platform === 'instagram' && (
										<svg class="size-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
											<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z" />
										</svg>
									)}
								</a>
							))}
						</div>
					)
				}
			</div>
		</div>

		<!-- Bottom bar -->
		<div class="border-primary-foreground/10 border-t py-6">
			<div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
				{
					footerConfig.showCopyright && (
						<p class="text-primary-foreground/60 text-sm">
							&copy; {n} {settings?.siteName}. All rights reserved.
						</p>
					)
				}
			</div>
		</div>
	</Container>
</footer>
