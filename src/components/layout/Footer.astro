---
// Components
import { footerConfig, navigationConfig } from '@/components/config/navigation'
import Social from '@/components/elements/content/Social.astro'
import Container from '@/components/layout/Container.astro'
import { loadQuery } from '@/sanity/lib/load-query'
import { contactPageQuery, settingsQuery } from '@/sanity/lib/queries'
import type { Contact } from '@/sanity/schemaTypes/contact'
import type { SiteSettings } from '@/sanity/schemaTypes/siteSettings'
import { Image } from 'astro:assets'

// Icons
import { Mail, MapPin, Phone } from 'lucide-astro'

// Misc
const d = new Date()
const n = d.getFullYear()
const { data: settings } = await loadQuery<SiteSettings>({ query: settingsQuery })
const { data: contact } = await loadQuery<Contact>({ query: contactPageQuery })
const socialMedia = (Array.isArray(contact?.social) ? contact.social : []).filter(
	(s) => s?.socialUrl && s?.socialSite
) as {
	socialSite: string
	socialUrl: string
}[]

// Group navigation into columns
const exploreLinks = navigationConfig.slice(0, 3)
---

<footer class="bg-primary text-primary-foreground relative overflow-hidden">
	<!-- Wave divider at top of footer -->
	<div
		class="pointer-events-none absolute top-0 right-0 left-0"
		aria-hidden="true"
		style="transform: rotate(180deg);"
	>
		<svg
			viewBox="0 0 1440 60"
			class="text-background w-full fill-current"
			preserveAspectRatio="none"
			style="display: block;"
		>
			<path d="M0,30 Q360,60 720,30 T1440,30 L1440,60 L0,60Z"></path>
		</svg>
	</div>

	<!-- Large Fraunces watermark -->
	<div
		class="pointer-events-none absolute right-0 bottom-0 overflow-hidden select-none"
		aria-hidden="true"
	>
		<p
			class="text-primary-foreground text-right leading-[0.85] font-black"
			style="font-size: clamp(5rem, 14vw, 14rem); font-family: 'Fraunces', Georgia, serif; opacity: 0.04; white-space: nowrap;"
		>
			Wild &amp;<br />Wonderful
		</p>
	</div>

	<!-- Decorative organic pattern -->
	<div class="pointer-events-none absolute inset-0 opacity-[0.06]" aria-hidden="true">
		<svg class="h-full w-full" xmlns="http://www.w3.org/2000/svg">
			<defs>
				<pattern
					id="footer-pattern"
					x="0"
					y="0"
					width="100"
					height="100"
					patternUnits="userSpaceOnUse"
				>
					<path
						d="M50 20 Q60 10 70 20 T90 20"
						fill="none"
						stroke="currentColor"
						stroke-width="1"
						opacity="0.5"></path>
					<circle
						cx="20"
						cy="50"
						r="8"
						fill="none"
						stroke="currentColor"
						stroke-width="0.8"
						opacity="0.4"></circle>
					<circle cx="80" cy="70" r="5" fill="currentColor" opacity="0.3"></circle>
					<path
						d="M10 80 Q30 70 50 80"
						fill="none"
						stroke="currentColor"
						stroke-width="0.8"
						opacity="0.4"></path>
				</pattern>
			</defs>
			<rect width="100%" height="100%" fill="url(#footer-pattern)"></rect>
		</svg>
	</div>

	<Container class="relative z-10 pt-20">
		<!-- Main footer content -->
		<div class="grid gap-12 py-16 md:grid-cols-2 lg:grid-cols-4">
			<!-- Brand column -->
			<div class="space-y-6">
				<div class="flex items-center gap-3">
					<Image
						src="/images/logo.png"
						alt="Wellness Passport"
						width={140}
						height={140}
						class="h-24 w-auto md:h-32"
					/>
				</div>
				<p class="text-primary-foreground/60 mt-3 max-w-[200px] text-sm leading-relaxed">
					Exploring Monongalia County one stamp at a time.
				</p>
			</div>

			<!-- Explore column -->
			<div class="space-y-4">
				<h4
					class="text-primary-foreground/90 flex items-center text-sm font-semibold tracking-wider uppercase"
				>
					<span class="bg-warning/60 mr-1.5 inline-block size-1.5 rounded-full" aria-hidden="true"
					></span>
					Explore
				</h4>
				<ul class="space-y-3">
					{
						exploreLinks.map((item) => (
							<li>
								<a
									href={item.href}
									class="text-primary-foreground/70 hover:text-primary-foreground inline-flex items-center gap-2 text-sm transition-colors"
								>
									{item.label}
								</a>
							</li>
						))
					}
					<li>
						<a
							href="/partners"
							class="text-primary-foreground/70 hover:text-primary-foreground inline-flex items-center gap-2 text-sm transition-colors"
						>
							Partners
						</a>
					</li>
				</ul>
			</div>

			<!-- Contact column -->
			<div class="space-y-4">
				<h4
					class="text-primary-foreground/90 flex items-center text-sm font-semibold tracking-wider uppercase"
				>
					<span class="bg-warning/60 mr-1.5 inline-block size-1.5 rounded-full" aria-hidden="true"
					></span>
					Contact
				</h4>
				<ul class="space-y-3">
					<li class="flex items-start gap-3 text-sm">
						<MapPin class="text-primary-foreground/70 mt-0.5 size-4 shrink-0" aria-hidden="true" />
						<span class="text-primary-foreground/70">
							Monongalia County<br />Health Department<br />Morgantown, WV 26505
						</span>
					</li>
					<li class="flex items-center gap-3 text-sm">
						<Phone class="text-primary-foreground/70 size-4 shrink-0" aria-hidden="true" />
						<a
							href={`tel:${(contact?.phone || '').replace(/[^0-9+]/g, '')}`}
							class="text-primary-foreground/70 hover:text-primary-foreground transition-colors"
						>
							{contact?.phone || '(304) 598-5100'}
						</a>
					</li>
					<li class="flex items-center gap-3 text-sm">
						<Mail class="text-primary-foreground/70 size-4 shrink-0" aria-hidden="true" />
						<a
							href={`mailto:${contact?.email || 'wellness@monongaliahealth.org'}`}
							class="text-primary-foreground/70 hover:text-primary-foreground transition-colors"
						>
							{contact?.email || 'wellness@monongaliahealth.org'}
						</a>
					</li>
				</ul>
			</div>

			<!-- Connect column -->
			<div class="space-y-4">
				<h4
					class="text-primary-foreground/90 flex items-center text-sm font-semibold tracking-wider uppercase"
				>
					<span class="bg-warning/60 mr-1.5 inline-block size-1.5 rounded-full" aria-hidden="true"
					></span>
					Connect
				</h4>

				<!-- Social links -->
				{
					socialMedia.length > 0 && (
						<Social settings={{ socialMedia }} class="pt-2 text-primary-foreground [&_a:hover]:text-warning! [&_svg_*]:fill-current [&_svg]:fill-current" />
					)
				}
			</div>
		</div>

		<!-- Bottom bar -->
		<div class="border-primary-foreground/10 border-t py-6">
			<div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
				{
					footerConfig.showCopyright && (
						<p class="text-primary-foreground/60 text-sm">
							&copy; {n} {settings?.siteName}. All rights reserved.
						</p>
					)
				}
			</div>
		</div>
	</Container>
</footer>
