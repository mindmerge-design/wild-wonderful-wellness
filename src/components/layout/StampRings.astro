---
/**
 * Concentric decorative rings for hero sections (right-side decoration).
 */
interface Props {
	class?: string
}

const { class: className } = Astro.props
---

<div
	class:list={['pointer-events-none absolute -right-24 top-1/2 -translate-y-1/2', className]}
	aria-hidden="true"
>
	<div
		class="absolute size-[520px] -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-dashed border-white/20 opacity-30"
	></div>
	<div
		class="absolute size-[380px] -translate-x-1/2 -translate-y-1/2 rounded-full border border-dashed border-white/15 opacity-25"
	></div>
	<div
		class="absolute size-[240px] -translate-x-1/2 -translate-y-1/2 rounded-full border border-dashed border-white/10 opacity-20"
	></div>
</div>
