---
import { MapPin } from 'lucide-astro'

interface Props {
	title?: string
	class?: string
}

const { title = 'Explore the Map', class: className } = Astro.props
---

<div
	class={`bg-muted relative flex min-h-[300px] items-center justify-center overflow-hidden rounded-lg border border-border ${className ?? ''}`}
	role="img"
	aria-label={title}
>
	<div class="text-center">
		<MapPin class="text-primary mx-auto mb-3 size-12 opacity-40" />
		<p class="text-muted-foreground text-sm font-medium">{title}</p>
		<p class="text-muted-foreground mt-1 text-xs">Interactive map coming soon</p>
	</div>
</div>
