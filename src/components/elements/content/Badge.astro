---
import { tv, type VariantProps } from 'tailwind-variants'

const badge = tv({
	base: 'inline-flex items-center rounded-full px-3 py-1 text-xs font-medium',
	variants: {
		variant: {
			default: 'bg-muted text-muted-foreground',
			primary: 'bg-primary/10 text-primary',
			secondary: 'bg-secondary/10 text-secondary',
			accent: 'bg-accent/20 text-accent-foreground',
			success: 'bg-success/10 text-success',
			info: 'bg-info/10 text-info',
			warning: 'bg-warning/10 text-warning',
			error: 'bg-error/10 text-error',
			outline: 'border border-border text-foreground'
		}
	},
	defaultVariants: { variant: 'default' }
})

interface Props extends VariantProps<typeof badge> {
	class?: string
}

const { variant, class: className } = Astro.props
---

<span class={badge({ variant, class: className })}>
	<slot />
</span>
