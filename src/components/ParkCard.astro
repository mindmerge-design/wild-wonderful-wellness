---
import type { ParkTrail } from '@/sanity/schemaTypes/parkTrail'
import Button from './starwind/button'

// Reusable Park Card Component
// Used on homepage and parks-and-trails page

interface Props {
	park: ParkTrail
	index: number
	size?: 'sm' | 'md' | 'lg'
}

const { park, index, size = 'md' } = Astro.props

// Generate URL-friendly slug from title
const slug =
	park.slug?.current ||
	(park.title || 'park')
		.toLowerCase()
		.replace(/[^a-z0-9]+/g, '-')
		.replace(/^-|-$/g, '')
const href = `/parks-and-trails/${slug}`

// Size variants (for non-layout properties)
const sizeClasses = {
	sm: {
		number: 'size-5 text-[10px]',
		title: 'text-sm',
		desc: 'text-xs line-clamp-2',
		padding: 'p-3'
	},
	md: {
		number: 'size-6 text-xs',
		title: 'text-base',
		desc: 'text-sm line-clamp-2',
		padding: 'p-4'
	},
	lg: {
		number: 'size-7 text-sm',
		title: 'text-lg',
		desc: 'text-base leading-relaxed mb-3',
		padding: 'p-5'
	}
}

const s = sizeClasses[size]
---

<div
	id={`park-${index}`}
	class="group border-border bg-card hover:border-success/30 relative flex h-full cursor-pointer flex-col overflow-hidden rounded-xl border transition-all duration-300 hover:shadow-lg"
	style={`animation: fade-in-up 0.4s ease-out ${0.05 * index}s both;`}
>
	<!-- Park Info (Full width) -->
	<div class={`flex h-full flex-col ${s.padding}`}>
		<div class="mb-2 flex items-start justify-between gap-2">
			<div class="flex items-center gap-2">
				<div
					class={`${s.number} flex shrink-0 items-center justify-center rounded-full bg-success font-bold text-white!`}
				>
					{index + 1}
				</div>
				<h4
					class={`font-bold text-foreground group-hover:text-success mt-0! transition-colors ${s.title}`}
				>
					{park.title}
				</h4>
			</div>
		</div>

		<span
			class="bg-success/10 text-success mb-2 inline-flex w-fit shrink-0 items-center rounded-full px-2 py-0.5 text-xs font-medium capitalize"
		>
			{park.parkType?.replace('-', ' ') || 'Park'}
		</span>

		<p class={`text-muted-foreground grow ${s.desc}`}>{park.shortDescription || ''}</p>

		<div class="mt-auto pt-3">
			<div class="mb-3 flex flex-wrap items-center gap-2">
				{
					park.amenities && park.amenities.length > 0 && (
						<>
							{park.amenities.slice(0, 3).map((amenity) => (
								<span class="border-border text-muted-foreground inline-flex items-center rounded-md border px-2 py-1 text-xs capitalize">
									{amenity.replace('-', ' ')}
								</span>
							))}
							{park.amenities.length > 3 && (
								<span class="text-muted-foreground text-xs">+{park.amenities.length - 3} more</span>
							)}
						</>
					)
				}
			</div>
			<Button href={href} variant="primary" class="w-full no-underline" size="sm">
				Learn More
				<svg
					class="size-3"
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<path d="M5 12h14"></path>
					<path d="m12 5 7 7-7 7"></path>
				</svg>
			</Button>
		</div>
	</div>
</div>
