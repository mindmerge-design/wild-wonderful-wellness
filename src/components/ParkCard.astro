---
import type { ParkTrail } from '@/sanity/schemaTypes/parkTrail'
import { urlForImage } from '@/sanity/lib/urlForImage'
import { Button } from '@/components/starwind/button'

// Reusable Park Card Component
// Used on homepage and parks-and-trails page

interface Props {
	park: ParkTrail
	index: number
	size?: 'sm' | 'md' | 'lg'
}

const { park, index, size = 'md' } = Astro.props

// Generate URL-friendly slug from title
const slug =
	park.slug?.current ||
	(park.title || 'park')
		.toLowerCase()
		.replace(/[^a-z0-9]+/g, '-')
		.replace(/^-|-$/g, '')
const href = `/parks-and-trails/${slug}`

// Size variants (for non-layout properties)
const sizeClasses = {
	sm: {
		number: 'size-5 text-[10px]',
		title: 'text-sm',
		desc: 'text-xs line-clamp-2',
		padding: 'p-3'
	},
	md: {
		number: 'size-6 text-xs',
		title: 'text-base',
		desc: 'text-sm line-clamp-2',
		padding: 'p-4'
	},
	lg: {
		number: 'size-7 text-sm',
		title: 'text-lg',
		desc: 'text-base leading-relaxed mb-3',
		padding: 'p-5'
	}
}

const s = sizeClasses[size]
---

<a
	href={href}
	id={`park-${index}`}
	class="group border-border bg-card hover:border-success/30 relative flex h-full cursor-pointer flex-col overflow-hidden rounded-xl border border-t-4 border-t-success transition-all duration-300 hover:-translate-y-1 hover:shadow-xl no-underline"
	style={`animation: fade-in-up 0.4s ease-out ${0.05 * index}s both;`}
>
	<!-- Dot texture background -->
	<div class="pointer-events-none absolute inset-0 opacity-[0.025]" aria-hidden="true">
		<svg class="h-full w-full" xmlns="http://www.w3.org/2000/svg">
			<defs>
				<pattern id={`dots-park-${index}`} x="0" y="0" width="16" height="16" patternUnits="userSpaceOnUse">
					<circle cx="2" cy="2" r="1" fill="currentColor" class="text-success" />
				</pattern>
			</defs>
			<rect width="100%" height="100%" fill={`url(#dots-park-${index})`} />
		</svg>
	</div>

	<!-- Main Image - 4/3 aspect ratio -->
	{park.mainImage ? (
		<div class="relative aspect-4/3 w-full overflow-hidden shrink-0">
			<img
				src={urlForImage(park.mainImage).width(600).height(450).url()}
				alt={park.mainImage.alt || park.title}
				width={600}
				height={450}
				class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105 my-0!"
			/>
			<!-- Gradient overlay at bottom -->
			<div class="absolute inset-0 bg-linear-to-t from-black/40 via-transparent to-transparent"></div>
			<!-- Park type badge on image -->
			<div class="absolute bottom-3 left-3">
				<span class="inline-flex items-center gap-1.5 rounded-full bg-white/90 backdrop-blur-sm px-2.5 py-1 text-xs font-semibold text-success shadow-sm">
					<span class="size-1.5 rounded-full bg-success"></span>
					{park.parkType?.replace('-', ' ') || 'Park'}
				</span>
			</div>
		</div>
	) : (
		<!-- Placeholder when no image -->
		<div class="relative aspect-4/3 w-full overflow-hidden bg-success/10 shrink-0 flex items-center justify-center">
			<div class="text-center">
				<div class="mx-auto mb-2 flex size-12 items-center justify-center rounded-full bg-success/20">
					<svg class="size-6 text-success" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M8 3H5a2 2 0 0 0-2 2v3"></path>
						<path d="M21 8V5a2 2 0 0 0-2-2h-3"></path>
						<path d="M3 16v3a2 2 0 0 0 2 2h3"></path>
						<path d="M16 21h3a2 2 0 0 0 2-2v-3"></path>
					</svg>
				</div>
				<span class="inline-flex items-center gap-1.5 rounded-full bg-success/10 px-2.5 py-1 text-xs font-medium text-success">
					<span class="size-1.5 rounded-full bg-success"></span>
					{park.parkType?.replace('-', ' ') || 'Park'}
				</span>
			</div>
		</div>
	)}

	<!-- Watermark index number -->
	<span
		class="text-success/[0.05] pointer-events-none absolute -right-1 -bottom-2 select-none text-[5rem] font-black leading-none"
		aria-hidden="true"
	>
		{index + 1}
	</span>

	<!-- Park Info (Full width) -->
	<div class={`relative flex h-full flex-col ${s.padding}`}>
		<div class="mb-2 flex items-start justify-between gap-2">
			<div class="flex items-center gap-2">
				<div
					class={`${s.number} flex shrink-0 items-center justify-center rounded-full bg-success font-bold text-white!`}
				>
					{index + 1}
				</div>
				<h4
					class={`font-bold text-foreground group-hover:text-success mt-0! transition-colors ${s.title}`}
				>
					{park.title}
				</h4>
			</div>
		</div>

		<p class={`text-muted-foreground grow ${s.desc}`}>{park.shortDescription || ''}</p>

		<div class="mt-auto pt-3">
			<div class="mb-3 flex flex-wrap items-center gap-2">
				{
					park.amenities && park.amenities.length > 0 && (
						<>
							{park.amenities.slice(0, 3).map((amenity) => (
								<span class="border-border text-muted-foreground inline-flex items-center rounded-md border px-2 py-1 text-xs capitalize">
									{amenity.replace('-', ' ')}
								</span>
							))}
							{park.amenities.length > 3 && (
								<span class="text-muted-foreground text-xs">+{park.amenities.length - 3} more</span>
							)}
						</>
					)
				}
			</div>
			<span class="inline-flex items-center justify-center gap-2 rounded-md bg-success px-4 py-2 text-sm font-medium text-white w-full">
				Learn More
				<svg
					class="size-3"
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M5 12h14"></path>
					<path d="m12 5 7 7-7 7"></path>
				</svg>
			</span>
		</div>
	</div>
</a>
