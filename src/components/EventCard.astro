---
import { Image } from 'astro:assets'
import { ArrowRight, MapPin } from 'lucide-astro'
import Badge from '@/components/elements/content/Badge.astro'
import { urlForImage } from '@/sanity/lib/urlForImage'
import type { Event } from '@/sanity/schemaTypes/event'

interface Props {
	event: Event
	index?: number
	variant?: 'upcoming' | 'past'
}

const { event, index = 0, variant = 'upcoming' } = Astro.props

const href = `/events/${event.slug?.current}`

function getMonth(dateStr: string) {
	return new Date(dateStr).toLocaleDateString('en-US', { month: 'short' })
}

function getDay(dateStr: string) {
	return new Date(dateStr).getDate().toString()
}

function formatDate(dateStr: string) {
	return new Date(dateStr).toLocaleDateString('en-US', {
		weekday: 'long',
		month: 'long',
		day: 'numeric',
		year: 'numeric'
	})
}
---

{variant === 'upcoming' ? (
	<a
		href={href}
		class="group relative flex flex-col overflow-hidden rounded-2xl border border-border bg-card no-underline transition-all duration-300 hover:shadow-xl hover:-translate-y-1 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-warning"
		style={`animation: fade-in-up 0.5s ease-out ${0.08 * index}s both;`}
		aria-label={`${event.title}, ${formatDate(event.eventDate)}`}
	>
		<!-- Colored top bar -->
		<div class="h-1.5 w-full bg-warning/80 shrink-0"></div>

		{event.mainImage ? (
			<div class="relative h-44 overflow-hidden shrink-0">
				<Image
					src={urlForImage(event.mainImage).width(600).height(352).url()}
					alt={event.mainImage.alt || event.title}
					width={600}
					height={352}
					class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
				/>
				<div class="absolute inset-0 bg-linear-to-t from-black/50 to-transparent"></div>
				<!-- Date badge overlaid on image -->
				<div class="absolute bottom-3 left-3 shrink-0 min-w-[52px] rounded-xl border border-warning/40 bg-black/70 backdrop-blur-sm px-2 py-2.5 text-center shadow-lg">
					<p class="text-[9px] font-bold uppercase tracking-widest text-warning leading-none mb-1">
						{getMonth(event.eventDate)}
					</p>
					<p class="text-xl font-extrabold leading-none text-white">
						{getDay(event.eventDate)}
					</p>
				</div>
				{event.isFree && (
					<div class="absolute top-3 right-3">
						<Badge variant="success">Free</Badge>
					</div>
				)}
				{!event.isFree && event.cost && (
					<div class="absolute top-3 right-3">
						<Badge variant="warning">{event.cost}</Badge>
					</div>
				)}
			</div>
		) : null}

		<div class="flex flex-1 flex-col p-5">
			{!event.mainImage ? (
				<div class="mb-4 flex items-start gap-4">
					<!-- Calendar date badge -->
					<div class="shrink-0 min-w-[52px] rounded-xl border border-warning/25 bg-warning/10 px-2 py-2.5 text-center">
						<p class="text-[9px] font-bold uppercase tracking-widest text-warning leading-none mb-1">
							{getMonth(event.eventDate)}
						</p>
						<p class="text-xl font-extrabold leading-none text-foreground">
							{getDay(event.eventDate)}
						</p>
					</div>
					<div class="flex-1 min-w-0">
						<div class="mb-1.5 flex flex-wrap gap-1.5">
							{event.isFree && <Badge variant="success">Free</Badge>}
							{!event.isFree && event.cost && <Badge variant="warning">{event.cost}</Badge>}
						</div>
						<h3 class="text-base font-bold leading-snug group-hover:text-warning transition-colors mt-0!">
							{event.title}
						</h3>
					</div>
				</div>
			) : (
				<h3 class="mb-2 text-base font-bold leading-snug group-hover:text-warning transition-colors mt-0!">
					{event.title}
				</h3>
			)}

			{event.location && (
				<p class="text-muted-foreground mb-3 flex items-center gap-2 text-sm">
					<MapPin class="size-3.5 shrink-0 text-warning" aria-hidden="true" />
					<span class="truncate">{event.location}</span>
				</p>
			)}

			{event.shortDescription && (
				<p class="text-muted-foreground mb-4 flex-1 text-sm leading-relaxed line-clamp-2">
					{event.shortDescription}
				</p>
			)}

			<div class="mt-auto flex items-center gap-1 text-sm font-semibold text-warning">
				<span>Learn More</span>
				<ArrowRight class="size-3.5 transition-transform group-hover:translate-x-1" aria-hidden="true" />
			</div>
		</div>
	</a>
) : (
	/* Past event */
	<a
		href={href}
		class="group relative flex overflow-hidden rounded-2xl border border-border bg-card no-underline opacity-80 transition-all duration-300 hover:opacity-100 hover:shadow-lg hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
		style={`animation: fade-in-up 0.5s ease-out ${0.07 * index}s both;`}
		aria-label={`${event.title}, ${formatDate(event.eventDate)}`}
	>
		{event.mainImage ? (
			<div class="flex flex-col w-full">
				<div class="relative h-36 overflow-hidden shrink-0">
					<Image
						src={urlForImage(event.mainImage).width(600).height(288).url()}
						alt={event.mainImage.alt || event.title}
						width={600}
						height={288}
						class="h-full w-full object-cover grayscale transition-all duration-300 group-hover:grayscale-0 group-hover:scale-105"
					/>
					<div class="absolute inset-0 bg-linear-to-t from-black/40 to-transparent"></div>
					<div class="absolute bottom-2 left-2 shrink-0 min-w-[44px] rounded-lg border border-white/20 bg-black/60 backdrop-blur-sm px-1.5 py-2 text-center">
						<p class="text-[8px] font-bold uppercase tracking-widest text-white/70 leading-none mb-0.5">
							{getMonth(event.eventDate)}
						</p>
						<p class="text-base font-extrabold leading-none text-white">
							{getDay(event.eventDate)}
						</p>
					</div>
				</div>
				<div class="flex flex-col p-4">
					<h3 class="text-sm font-semibold leading-snug group-hover:text-primary transition-colors">
						{event.title}
					</h3>
					{event.location && (
						<p class="text-muted-foreground mt-1 flex items-center gap-1 text-xs">
							<MapPin class="size-3 shrink-0" aria-hidden="true" />
							<span class="truncate">{event.location}</span>
						</p>
					)}
				</div>
			</div>
		) : (
			<div class="flex w-full items-start gap-4 p-4">
				<div class="shrink-0 min-w-[48px] rounded-xl border border-border bg-background px-2 py-2.5 text-center">
					<p class="text-[9px] font-bold uppercase tracking-widest text-muted-foreground leading-none mb-1">
						{getMonth(event.eventDate)}
					</p>
					<p class="text-lg font-extrabold leading-none text-foreground">
						{getDay(event.eventDate)}
					</p>
				</div>
				<div class="flex-1 min-w-0">
					<h3 class="text-sm font-semibold leading-snug group-hover:text-primary transition-colors">
						{event.title}
					</h3>
					{event.location && (
						<p class="text-muted-foreground mt-1 flex items-center gap-1 text-xs">
							<MapPin class="size-3 shrink-0" aria-hidden="true" />
							<span class="truncate">{event.location}</span>
						</p>
					)}
				</div>
			</div>
		)}
	</a>
)}
